+fn emit_read_tail(ctx: &mut JitContext, bits: BitSize, where_to_write: Option<u32>, atomic: bool) {
+    // стек: [физический адрес]
+    let b = &mut *ctx.builder;
+    if !atomic && SMP_PROBE != 4 {
+        b.atomic_fence();
+    }
+    let ld = |b: &mut WasmBuilder, op: MemOp, off: u32| {
+        if atomic {
+            mem_fast(b, op, off)
+        }
+        else {
+            mem_plain(b, op, off)
+        }
+    };
+    match bits {
+        BitSize::BYTE => ld(b, MemOp::L8, 0),
+        BitSize::WORD => ld(b, MemOp::L16, 0),
+        BitSize::DWORD => ld(b, MemOp::L32, 0),
+        BitSize::QWORD => ld(b, MemOp::L64, 0),
+        BitSize::DQWORD => {
+            let w = where_to_write.unwrap();
+            let v = b.set_new_local();
+            b.const_i32(0);
+            b.get_local(&v);
+            ld(b, MemOp::L64, 0);
+            b.store_unaligned_i64(w);
+            b.const_i32(0);
+            b.get_local(&v);
+            ld(b, MemOp::L64, 8);
+            b.store_unaligned_i64(w + 8);
+            b.free_local(v);
+        },
+    }
+}
+
+fn gen_align_check(ctx: &mut JitContext, bits: BitSize, address_local: &WasmLocal) {
+    // стек: [tlb в порядке]; оставляет [tlb в порядке && выровнено]: выровненное до 8 байт
+    // страницу не пересекает, 16 байт - выровнено на 8 и не через страницу
+    let b = &mut *ctx.builder;
+    if SMP_PROBE == 4 {
+        if bits != BitSize::BYTE {
+            b.get_local(address_local);
+            b.const_i32(0xFFF);
+            b.and_i32();
+            b.const_i32(0x1000 - bits.bytes() as i32);
+            b.le_i32();
+            b.and_i32();
+        }
+        return;
+    }
+    match bits {
+        BitSize::BYTE => {},
+        BitSize::DQWORD => {
+            b.get_local(address_local);
+            b.const_i32(0xFFF);
+            b.and_i32();
+            b.const_i32(0x1000 - 16);
+            b.le_i32();
+            b.and_i32();
+            b.get_local(address_local);
+            b.const_i32(7);
+            b.and_i32();
+            b.eqz_i32();
+            b.and_i32();
+        },
+        _ => {
+            b.get_local(address_local);
+            b.const_i32(bits.bytes() as i32 - 1);
+            b.and_i32();
+            b.eqz_i32();
+            b.and_i32();
+        },
+    }
+}
+
+fn gen_safe_read_fold(
+    ctx: &mut JitContext,
+    bits: BitSize,
+    address_local: &WasmLocal,
+    where_to_write: Option<u32>,
+) {
+    let end = ctx.builder.block_result(match bits {
+        BitSize::DQWORD => 0,
+        BitSize::QWORD => 2,
+        _ => 1,
+    });
+    let slow = ctx.builder.block_void();
+    ctx.builder.get_local(address_local);
+    ctx.builder.const_i32(12);
+    ctx.builder.shr_u_i32();
+    ctx.builder.const_i32(2);
+    ctx.builder.shl_i32();
+    ctx.builder
+        .load_aligned_i32(unsafe { &tlb_data[0] as *const i32 as u32 });
+    let entry_local = ctx.builder.tee_new_local();
+    ctx.builder.const_i32(
+        (0xFFF
+            & !TLB_READONLY
+            & !TLB_GLOBAL
+            & !TLB_HAS_CODE
+            & !TLB_NO_EXEC
+            & !(if ctx.cpu.cpl3() { 0 } else { TLB_NO_USER })) as i32,
+    );
+    ctx.builder.and_i32();
+    ctx.builder.const_i32(TLB_VALID as i32);
+    ctx.builder.eq_i32();
+    gen_align_check(ctx, bits, address_local);
+    ctx.builder.eqz_i32();
+    ctx.builder.br_if(slow);
+    // быстрый путь: выровнено - атомарно
+    ctx.builder.get_local(&entry_local);
+    ctx.builder.const_i32(!0xFFF);
+    ctx.builder.and_i32();
+    ctx.builder.get_local(address_local);
+    ctx.builder.xor_i32();
+    emit_read_tail(ctx, bits, where_to_write, true);
+    ctx.builder.br(end);
+    ctx.builder.block_end();
+    // медленный путь: промах TLB, невыровнено, через страницу, MMIO
+    ctx.builder.get_local(address_local);
+    ctx.builder
+        .const_i32(ctx.start_of_current_instruction as i32 & 0xFFF);
+    match bits {
+        BitSize::BYTE => ctx.builder.call_fn2_ret("safe_read8_slow_jit"),
+        BitSize::WORD => ctx.builder.call_fn2_ret("safe_read16_slow_jit"),
+        BitSize::DWORD => ctx.builder.call_fn2_ret("safe_read32s_slow_jit"),
+        BitSize::QWORD => ctx.builder.call_fn2_ret("safe_read64s_slow_jit"),
+        BitSize::DQWORD => ctx.builder.call_fn2_ret("safe_read128s_slow_jit"),
+    }
+    ctx.builder.tee_local(&entry_local);
+    ctx.builder.const_i32(1);
+    ctx.builder.and_i32();
+    ctx.builder.br_if(ctx.exit_with_fault_label);
+    ctx.builder.get_local(&entry_local);
+    ctx.builder.const_i32(!0xFFF);
+    ctx.builder.and_i32();
+    ctx.builder.get_local(address_local);
+    ctx.builder.xor_i32();
+    emit_read_tail(ctx, bits, where_to_write, false);
+    ctx.builder.block_end();
+    ctx.builder.free_local(entry_local);
+}
+
+fn emit_write_tail(ctx: &mut JitContext, bits: BitSize, value_local: &GenSafeWriteValue, atomic: bool) {
+    // стек: [физический адрес]
+    let b = &mut *ctx.builder;
+    if !atomic && SMP_PROBE != 4 {
+        b.atomic_fence();
+    }
+    let st = |b: &mut WasmBuilder, op: MemOp, off: u32| {
+        if atomic {
+            mem_fast(b, op, off)
+        }
+        else {
+            mem_plain(b, op, off)
+        }
+    };
+    match value_local {
+        GenSafeWriteValue::I32(local) => {
+            b.get_local(local);
+            match bits {
+                BitSize::BYTE => st(b, MemOp::S8, 0),
+                BitSize::WORD => st(b, MemOp::S16, 0),
+                _ => st(b, MemOp::S32, 0),
+            }
+        },
+        GenSafeWriteValue::I64(local) => {
+            b.get_local_i64(local);
+            st(b, MemOp::S64, 0);
+        },
+        GenSafeWriteValue::TwoI64s(local1, local2) => {
+            let v = b.tee_new_local();
+            b.get_local_i64(local1);
+            st(b, MemOp::S64, 0);
+            b.get_local(&v);
+            b.get_local_i64(local2);
+            st(b, MemOp::S64, 8);
+            b.free_local(v);
+        },
+    }
+}
+
+fn gen_safe_write_fold(
+    ctx: &mut JitContext,
+    bits: BitSize,
+    address_local: &WasmLocal,
+    value_local: GenSafeWriteValue,
+) {
+    let end = ctx.builder.block_void();
+    let slow = ctx.builder.block_void();
+    ctx.builder.get_local(address_local);
+    ctx.builder.const_i32(12);
+    ctx.builder.shr_u_i32();
+    ctx.builder.const_i32(2);
+    ctx.builder.shl_i32();
+    ctx.builder
+        .load_aligned_i32(unsafe { &tlb_data[0] as *const i32 as u32 });
+    let entry_local = ctx.builder.tee_new_local();
+    ctx.builder.const_i32(
+        (0xFFF & !TLB_GLOBAL & !TLB_NO_EXEC & !(if ctx.cpu.cpl3() { 0 } else { TLB_NO_USER }))
+            as i32,
+    );
+    ctx.builder.and_i32();
+    ctx.builder.const_i32(TLB_VALID as i32);
+    ctx.builder.eq_i32();
+    gen_align_check(ctx, bits, address_local);
+    ctx.builder.eqz_i32();
+    ctx.builder.br_if(slow);
+    ctx.builder.get_local(&entry_local);
+    ctx.builder.const_i32(!0xFFF);
+    ctx.builder.and_i32();
+    ctx.builder.get_local(address_local);
+    ctx.builder.xor_i32();
+    emit_write_tail(ctx, bits, &value_local, true);
+    ctx.builder.br(end);
+    ctx.builder.block_end();
+    ctx.builder.get_local(address_local);
+    match &value_local {
+        GenSafeWriteValue::I32(local) => ctx.builder.get_local(local),
+        GenSafeWriteValue::I64(local) => ctx.builder.get_local_i64(local),
+        GenSafeWriteValue::TwoI64s(local1, local2) => {
+            ctx.builder.get_local_i64(local1);
+            ctx.builder.get_local_i64(local2)
+        },
+    }
+    ctx.builder.const_i32(
+        ctx.start_of_current_instruction as i32 & 0xFFF
+            | (ctx.wasm_table_index.to_u16() as i32) << 16,
+    );
+    match bits {
+        BitSize::BYTE => ctx.builder.call_fn3_ret("safe_write8_slow_jit"),
+        BitSize::WORD => ctx.builder.call_fn3_ret("safe_write16_slow_jit"),
+        BitSize::DWORD => ctx.builder.call_fn3_ret("safe_write32_slow_jit"),
+        BitSize::QWORD => ctx
+            .builder
+            .call_fn3_i32_i64_i32_ret("safe_write64_slow_jit"),
+        BitSize::DQWORD => ctx
+            .builder
+            .call_fn4_i32_i64_i64_i32_ret("safe_write128_slow_jit"),
+    }
+    ctx.builder.tee_local(&entry_local);
+    ctx.builder.const_i32(1);
+    ctx.builder.and_i32();
+    ctx.builder.br_if(ctx.exit_with_fault_label);
+    ctx.builder.get_local(&entry_local);
+    ctx.builder.const_i32(!0xFFF);
+    ctx.builder.and_i32();
+    ctx.builder.get_local(address_local);
+    ctx.builder.xor_i32();
+    emit_write_tail(ctx, bits, &value_local, false);
+    ctx.builder.block_end();
+    ctx.builder.free_local(entry_local);
+}
