 use crate::regs;
 use crate::wasmgen::wasm_builder::{WasmBuilder, WasmLocal, WasmLocalI64};
 
+// Замер цены SMP (не для работы): 0 - как в v86, 1 - ветка по выравниванию, обычные операции
+// (невыровненные - с atomic.fence), 2 - то же, но выровненные - атомарные (порядок TSO на ARM),
+// 3 - атомики без лишней ветки: выравнивание - в проверке TLB, невыровненные - медленным путём
+// (чтение-изменение-запись - как 2), 4 - раскладка 3 (у быстрого и медленного пути свои хвосты),
+// но обычные операции и прежнее условие «не через страницу» - цена атомиков = 3 против 4
+pub const SMP_PROBE: u32 = 3;
+
+#[derive(Copy, Clone, PartialEq)]
+enum MemOp { L8, L16, L32, L64, S8, S16, S32, S64 }
+
+fn mem_plain(b: &mut WasmBuilder, op: MemOp, off: u32) {
+    match op {
+        MemOp::L8 => b.load_u8(off),
+        MemOp::L16 => b.load_unaligned_u16(off),
+        MemOp::L32 => b.load_unaligned_i32(off),
+        MemOp::L64 => b.load_unaligned_i64(off),
+        MemOp::S8 => b.store_u8(off),
+        MemOp::S16 => b.store_unaligned_u16(off),
+        MemOp::S32 => b.store_unaligned_i32(off),
+        MemOp::S64 => b.store_unaligned_i64(off),
+    }
+}
+
+fn mem_fast(b: &mut WasmBuilder, op: MemOp, off: u32) {
+    if SMP_PROBE < 2 || SMP_PROBE == 4 {
+        return mem_plain(b, op, off);
+    }
+    // i32.atomic.load8_u/16_u/load, i64.atomic.load, i32.atomic.store8/16/store, i64.atomic.store
+    let (sub, align) = match op {
+        MemOp::L8 => (0x12, 0),
+        MemOp::L16 => (0x13, 1),
+        MemOp::L32 => (0x10, 2),
+        MemOp::L64 => (0x11, 3),
+        MemOp::S8 => (0x19, 0),
+        MemOp::S16 => (0x1A, 1),
+        MemOp::S32 => (0x17, 2),
+        MemOp::S64 => (0x18, 3),
+    };
+    b.atomic_mem(sub, align, off);
+}
+
+// стек: [адрес] для чтения, [адрес, значение] для записи
+fn gen_mem(ctx: &mut JitContext, op: MemOp, off: u32) {
+    let b = &mut *ctx.builder;
+    if SMP_PROBE == 0 || SMP_PROBE == 4 {
+        return mem_plain(b, op, off);
+    }
+    let mask = match op {
+        MemOp::L8 | MemOp::S8 => return mem_fast(b, op, off),
+        MemOp::L16 | MemOp::S16 => 1,
+        MemOp::L32 | MemOp::S32 => 3,
+        MemOp::L64 | MemOp::S64 => 7,
+    };
+    match op {
+        MemOp::S64 => {
+            let v = b.set_new_local_i64();
+            let a = b.set_new_local();
+            b.get_local(&a);
+            b.const_i32(mask);
+            b.and_i32();
+            b.eqz_i32();
+            b.if_void();
+            b.get_local(&a);
+            b.get_local_i64(&v);
+            mem_fast(b, op, off);
+            b.else_();
+            b.atomic_fence();
+            b.get_local(&a);
+            b.get_local_i64(&v);
+            mem_plain(b, op, off);
+            b.block_end();
+            b.free_local(a);
+            b.free_local_i64(v);
+        },
+        MemOp::S16 | MemOp::S32 => {
+            let v = b.set_new_local();
+            let a = b.set_new_local();
+            b.get_local(&a);
+            b.const_i32(mask);
+            b.and_i32();
+            b.eqz_i32();
+            b.if_void();
+            b.get_local(&a);
+            b.get_local(&v);
+            mem_fast(b, op, off);
+            b.else_();
+            b.atomic_fence();
+            b.get_local(&a);
+            b.get_local(&v);
+            mem_plain(b, op, off);
+            b.block_end();
+            b.free_local(a);
+            b.free_local(v);
+        },
+        _ => {
+            let a = b.set_new_local();
+            b.get_local(&a);
+            b.const_i32(mask);
+            b.and_i32();
+            b.eqz_i32();
+            if op == MemOp::L64 { b.if_i64() } else { b.if_i32() }
+            b.get_local(&a);
+            mem_fast(b, op, off);
+            b.else_();
+            b.atomic_fence();
+            b.get_local(&a);
+            mem_plain(b, op, off);
+            b.block_end();
+            b.free_local(a);
+        },
+    }
+}
