#!/bin/sh
mountpoint -q /proc || mount -t proc proc /proc
# корень - tmpfs (ядро без root=): все файлы в ОЗУ. Ему - вся память без 16 МБ, иначе (как было с
# ramfs) файлы съедают её целиком, OOM убивает процессы, но память не освобождается, и ядро паникует;
# с пределом запись упирается в «No space left on device». Число файлов не ограничено. До этой строки
# действует предел распаковки initramfs из командной строки ядра (page.html)
mem=$(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo)
mount -o remount,size=$((mem - 16384))k,nr_inodes=0 /
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
ln -sf /proc/self/fd /dev/fd
ln -sf fd/0 /dev/stdin
ln -sf fd/1 /dev/stdout
ln -sf fd/2 /dev/stderr
mount -t devpts -o gid=5,mode=620,ptmxmode=0666 devpts /dev/pts 2>/dev/null
mount -t tmpfs -o mode=1777 tmpfs /dev/shm 2>/dev/null
# диск: virtio-9p страницы, содержимое файлов - в OPFS браузера, в ОЗУ - только то, что читают сейчас
# (кэш страниц, ядро его вытесняет). cache=0xb - файлы и метаданные в кэше без проверок (диск меняет
# только эта машина), без writeback: с ним файл уходит в OPFS, лишь когда ядро вытеснит inode;
# ignoreqv - у v86 версия qid всегда 0, без него кэша нет вовсе (patches/v86/13)
mkdir -p /disk
mount -t 9p -o trans=virtio,version=9p2000.L,cache=0xb,ignoreqv,msize=512000 host9p /disk 2>/dev/null || rmdir /disk
hostname -F /etc/hostname 2>/dev/null
