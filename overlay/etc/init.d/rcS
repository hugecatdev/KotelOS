#!/bin/sh
mountpoint -q /proc || mount -t proc proc /proc

run() {
  for i in /etc/init.d/S??*; do
    [ -f "$i" ] || continue
    case "$i" in
      *.sh) ( trap - INT QUIT TSTP; set start; . "$i" ) ;;
      *) "$i" start ;;
    esac
  done
}

if grep -qw quiet /proc/cmdline; then
  run > /dev/null 2>&1
else
  run
fi
