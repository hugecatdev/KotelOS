#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='code      выражение или функция JavaScript
arg...    аргументы функции, передаются строками
-f file   код из файла
без code  код из stdin'
kt_meta "<code> [arg...] | -f file [arg...]" "выполнить JS" "$@"
fn=
if [ "$1" = -f ]; then
  [ -r "$2" ] || { echo "kt js: нет файла $2" >&2; exit 1; }
  code=$(cat "$2")
  shift 2
  fn=1
elif [ $# -gt 1 ]; then
  case $1 in
    *"=>"*|function*|async*) code=$1; shift; fn=1 ;;
  esac
fi
if [ -n "$fn" ]; then
  a=$(kt_b64 "$code")
  for x in "$@"; do a="$a $(kt_b64 "$x")"; done
  kt_send js "$a"
else
  [ $# -gt 0 ] || [ ! -t 0 ] || kt_usage "<code> [arg...] | -f file [arg...]"
  kt_send js "$(kt_b64 "$@")"
fi
kt_status 6000
