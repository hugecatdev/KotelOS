#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  код из stdin: команда | kt js
<code>  выражение или функция JavaScript; результат - в stdout
<code> <arg>...  функция, аргументы уходят в неё строками
-f <file> [<arg>...]  код из файла'
kt_meta "[<code> [<arg>...] | -f <file> [<arg>...]]" "выполнить JS на странице" "$@"
if [ "$1" = -f ]; then
  [ -r "$2" ] || kt_die "нет файла $2"
  code=$(cat "$2")
  shift 2
elif [ $# -gt 0 ]; then
  code=$1
  shift
else
  [ ! -t 0 ] || kt_usage "[<code> [<arg>...] | -f <file> [<arg>...]]"
  code=$(cat)
fi
kt_js "$code" "$@"
