#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  текст из stdin: команда | kt copy
<text>  текст
-s  текст с экрана терминала'
kt_meta "[<text> | -s]" "в буфер обмена" "$@"
if [ "$1" = -s ]; then
  [ $# -eq 1 ] || kt_usage "[<text> | -s]"
  kt_page copyscreen ""
  exit
fi
[ $# -gt 0 ] || [ ! -t 0 ] || kt_usage "[<text> | -s]"
kt_page copy "$(kt_b64 "$@")"
