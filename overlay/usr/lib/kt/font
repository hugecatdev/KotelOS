#!/bin/sh
. /usr/lib/kt.sh
KT_CONSOLE=1
KT_HELP='без аргументов  шрифты и размер
<name>  шрифт из списка или любой с Google Fonts по имени, как kt cfg term.family
<size>  размер, 8..32, как kt cfg term.font
можно вместе: kt font jetbrains 15'
kt_meta "[<name>] [<size>]" "шрифт" "$@"
name= size=
for a in "$@"; do
  case $a in
    *[!0-9]*) name="${name:+$name }$a" ;;
    *) size=$a ;;
  esac
done
if [ -z "$name$size" ]; then
  kt_page font ""
  exit
fi
[ -z "$name" ] || kt_page cfg "$(kt_b64 "set term.family $name")" > /dev/null || exit 1
[ -z "$size" ] || kt_page cfg "$(kt_b64 "set term.font $size")" > /dev/null
