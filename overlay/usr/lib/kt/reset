#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  удалить сохранение бандла и начать со встроенного снимка; снимки остаются
-b  начать с ядра, а не со встроенного снимка
-y  без вопроса'
kt_meta "[-y] [-b]" "новая машина" "$@"
y= b=
while getopts :yb o; do
  case $o in
    y) y=1 ;;
    b) b=boot ;;
    *) kt_usage "[-y] [-b]" ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || kt_usage "[-y] [-b]"
[ -n "$y" ] || kt_ask "удалить сохранение и начать новую машину?" || exit 1
kt_page new "$(kt_b64 "$b")"
