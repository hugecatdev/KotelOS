#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='удаляет сохранение текущего бандла, снимки сохраняются
-y  без подтверждения
-b  загрузка с ядра вместо встроенного снимка'
kt_meta "[-y] [-b]" "новая машина" "$@"
y= b=
for a; do
  case $a in
    -y) y=1 ;;
    -b) b=boot ;;
    *) kt_usage "[-y] [-b]" ;;
  esac
done
if [ -z "$y" ]; then
  printf 'удалить сохранение и перезагрузить? [y/N] '
  read -r a
  case "$a" in y|Y|yes|д|Д|да) ;; *) exit 1 ;; esac
fi
kt_send new "$(kt_b64 "$b")"
kt_status
