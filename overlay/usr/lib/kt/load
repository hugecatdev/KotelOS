#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  вернуться к сохранению, несохранённое пропадёт
<name>  снимок вместо машины: он становится сохранением, прежнее пропадёт
-y  без вопроса'
kt_meta "[-y] [<name>]" "загрузить сохранение или снимок" "$@"
y=
while getopts :y o; do
  case $o in
    y) y=1 ;;
    *) kt_usage "[-y] [<name>]" ;;
  esac
done
shift $((OPTIND - 1))
[ $# -le 1 ] || kt_usage "[-y] [<name>]"
[ -z "$1" ] || kt_name "$1"
if [ -z "$y" ]; then
  if [ -n "$1" ]; then
    kt_ask "загрузить снимок $1 вместо машины? её сохранение пропадёт" || exit 1
  else
    kt_ask "вернуться к сохранению? несохранённое пропадёт" || exit 1
  fi
fi
kt_page load "$(kt_b64 "$1")"
