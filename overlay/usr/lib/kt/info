#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  строки «поле: значение»
browser  браузер и его версия
screen, terminal  экран устройства, терминал в столбцах и строках
mobile  интерфейс телефона, как term.mobile
tz  часовой пояс браузера
bundle, version  бандл (снимок, ядро - что в нём есть) и его метка
image  хеш образа, как kt -v
memory, vga  память машины, видеопамять и экран
save  сохранение: когда и сколько весит
save-image  есть, если сохранение от другого образа'
kt_meta "" "браузер и машина" "$@"
[ $# -eq 0 ] || kt_usage ""
kt_page info ""
