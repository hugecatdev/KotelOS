#!/bin/sh
. /usr/lib/kt.sh
KT_CONSOLE=1
KT_HELP='без аргументов  темы с образцами
<name>  выбрать тему, как kt cfg term.theme'
kt_meta "[<name>]" "тема" "$@"
[ $# -le 1 ] || kt_usage "[<name>]"
if [ -z "$1" ]; then
  kt_page theme ""
else
  kt_page cfg "$(kt_b64 "set term.theme $1")" > /dev/null
fi
