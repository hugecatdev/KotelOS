#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  установленное
search word     поиск по имени и описанию в репозитории и Alpine
search -r word  поиск только в репозитории
name...         состав и размер установки
add name...     установка с зависимостями из репозитория или Alpine
add -q name...  установка без вывода
rm name...      удаление, зависимости остаются
rm -d name...   удаление с неиспользуемыми зависимостями
rm -c name...   удаление вместе с пакетами, которым он нужен
rm -y name...   удаление без вопроса
files name...   файлы установленного пакета'
kt_meta "[search|add|rm|files] [name...]" "пакеты" "$@"
REPO=${KT_REPO:-$(kt cfg pkg.repo 2>/dev/null)}
REPO=${REPO:-/repo}
DB=/var/lib/kt/pkg
BASE=base
IDX=/var/lib/kt/index
AIDX=/var/lib/kt/alpine
MIR=/var/lib/kt/mirror
TRIG=/var/lib/kt/trigger
WORLD=/var/lib/kt/world
T=/tmp/.kt-pkg.$$
q=
ALP=
DEAD=
mkdir -p $DB
[ -f $WORLD ] || ls $DB | grep -vxF $BASE > $WORLD

clr() {
  [ -z "$q" ] || printf '\r\033[2K'
}

index() {
  if kt_get "$REPO/index.txt" $IDX.new 2>/dev/null; then
    mv $IDX.new $IDX
  elif [ ! -s $IDX ]; then
    clr
    echo "kt pkg: нет $REPO/index.txt" >&2
    exit 1
  fi
}

alpine() {
  if [ -s $AIDX ] && [ -z "$(find $AIDX -mmin +1440 2>/dev/null)" ]; then return 0; fi
  if kt_get "$REPO/alpine.txt.gz" $AIDX.gz 2>/dev/null && gunzip -c $AIDX.gz > $AIDX.new 2>/dev/null; then
    mv $AIDX.new $AIDX
  fi
  rm -f $AIDX.gz $AIDX.new
  [ -s $AIDX ]
}

files() {
  echo $IDX
  [ -z "$ALP" ] || echo $AIDX
}

fire() {
  for d in $TRIG/*.dirs; do
    [ -f "$d" ] || continue
    t=${d%.dirs}
    hit=$(awk -v dirs="$(cat "$d")" 'BEGIN { n = split(dirs, w, " ") }
      { f = "/" $0; for (i = 1; i <= n; i++) { x = w[i]; sub(/\*$/, "", x); if (x != "" && index(f, x) == 1) got[w[i]] = 1 } }
      END { for (k in got) printf "%s ", k }' "$@" 2>/dev/null)
    [ -z "$hit" ] || ( cd / && sh "$t" $hit ) > /dev/null 2>&1
  done
}

installed() {
  echo @
  ls $DB
}

remember() {
  for p in "$@"; do grep -qxF "$p" $WORLD || echo "$p" >> $WORLD; done
}

width() {
  w=$(stty size 2>/dev/null | cut -d" " -f2)
  echo "${w:-80}"
}

L='NR == FNR { inst[$1] = 1; next }
/^#/ || ($1 in known) { next }
{
  known[$1] = 1
  src[$1] = $6
  split($2, s, "/")
  dl[$1] = s[1] + 0
  mem[$1] = s[2] + 0
  deps[$1] = $3
  desc[$1] = $4
}'
H='function h(k) { return k >= 1024 ? sprintf("%.1fM", k / 1024) : k "K" }'
U='function len(s, t) { t = s; return length(s) - gsub(/[\200-\277]/, "", t) }
function cut(s, n, i, c) {
  for (i = 1; i <= length(s); i++) if (substr(s, i, 1) !~ /[\200-\277]/ && ++c > n) return substr(s, 1, i - 1)
  return s
}'
A='function pick(t, n, a, i) {
  n = split(t, a, "|")
  for (i = 1; i <= n; i++) if ((a[i] in inst) || (a[i] in W) || (a[i] in seen)) return a[i]
  return a[1]
}'

plan() {
  installed | awk -F'\t' -v want="$*" "$L$A"'
    function visit(p, n, a, i) {
      if (p in seen) return
      seen[p] = 1
      if (!(p in known)) { print "?" p; return }
      n = split(deps[p], a, " ")
      for (i = 1; i <= n; i++) visit(pick(a[i]))
      print p, dl[p], mem[p], (p in inst) ? 1 : 0, src[p]
    }
    END {
      n = split(want, w, " ")
      for (i = 1; i <= n; i++) W[w[i]] = 1
      for (i = 1; i <= n; i++) visit(w[i])
    }
  ' - $(files)
}

want() {
  list=$(plan "$@")
  if echo "$list" | grep -q '^?' && alpine; then
    ALP=1
    list=$(plan "$@")
  fi
}

check() {
  bad=$(echo "$1" | sed -n 's/^?//p')
  [ -z "$bad" ] || { clr; echo "kt pkg: нет пакета" $bad >&2; exit 1; }
}

total() {
  awk "$H"'
    $4 == 0 { n++; dl += $2; mem += $3 }
    END { if (n) printf "пакетов: %d, скачать %s, в памяти %s\n", n, h(dl), h(mem) }
  '
}

mirrors() {
  awk -F'\t' -v m="$(cat $MIR 2>/dev/null)" '
    !/^#/ { exit }
    /^#mirror/ { if ($2 == m) print $2; else l = l $2 "\n" }
    END { printf "%s", l }
  ' $AIDX
}

apk() {
  live=
  d=${1%/*}
  n=${1##*/}
  n=${n%-*-r*.apk}
  for m in $(mirrors); do
    case " $DEAD " in *" $m "*) continue ;; esac
    if e=$(kt_get "$m/$1" "$2" 2>&1); then
      echo "$m" > $MIR
      return 0
    fi
    case "$e" in
      *"fetch: 404"*) live=1 ;;
      *) DEAD="$DEAD $m"; continue ;;
    esac
    i=$T.i.$(echo "$m/$d" | tr -c 'a-zA-Z0-9\n' _)
    [ -f $i ] || kt_get "$m/$d/APKINDEX.tar.gz" $i 2>/dev/null || continue
    v=$(tar -xzOf $i APKINDEX 2>/dev/null | awk -v n="$n" '/^P:/ { p = substr($0, 3) } /^V:/ && p == n { print substr($0, 3); exit }')
    if [ -n "$v" ] && kt_get "$m/$d/$n-$v.apk" "$2" 2>/dev/null; then
      echo "$m" > $MIR
      return 0
    fi
  done
  [ -n "$live" ] || return 2
  return 1
}

fail() {
  if [ -n "$q" ]; then clr; else printf '\r!\n'; fi
  if [ "$2" = 2 ]; then echo "kt pkg: Alpine недоступен" >&2; else echo "kt pkg: не скачать $1" >&2; fi
  exit 1
}

case "$1" in
  "")
    index
    [ -s $WORLD ] || exit 0
    if awk -F'\t' 'NR == FNR { k[$1]; next } !($1 in k) { f = 1 } END { exit !f }' $IDX $WORLD && alpine; then ALP=1; fi
    installed | awk -F'\t' -v w="$(width)" -v world="$(tr '\n' ' ' < $WORLD)" "$L$H$A$U"'
      { order[++no] = $1 }
      function sum(p, n, a, i) {
        if (p in seen) return
        seen[p] = 1
        tdl += dl[p]
        tmem += mem[p]
        n = split(deps[p], a, " ")
        for (i = 1; i <= n; i++) sum(pick(a[i]))
      }
      function show(p, m, line, room, d) {
        split("", seen)
        tdl = tmem = 0
        sum(p)
        m = src[p] != "" ? "  (apk)" : ""
        line = sprintf("* %-" nw "s %6s", p, h(tdl))
        if (w >= 50) line = line sprintf(" %6s", h(tmem))
        room = w - length(line) - 2 - length(m)
        d = room > 8 ? cut(desc[p], room) : ""
        print line (d != "" ? "  " d : "") m
      }
      END {
        n = split(world, a, " ")
        for (i = 1; i <= n; i++) if (a[i] in inst) W[a[i]] = 1
        nw = 12
        for (p in W) if (len(p) > nw) nw = len(p)
        for (i = 1; i <= no; i++) if (order[i] in W) { show(order[i]); done[order[i]] = 1 }
        for (i = 1; i <= n; i++) if ((a[i] in W) && !(a[i] in done)) { print "* " a[i]; done[a[i]] = 1 }
      }
    ' - $(files) ;;
  search)
    shift
    r=
    [ "$1" = -r ] && r=1 && shift
    [ -n "$1" ] || kt_usage "search [-r] <word>"
    index
    if [ -z "$r" ] && alpine; then ALP=1; fi
    installed | awk -F'\t' -v w="$(width)" -v s="$1" "$H$U"'
      NR == FNR { inst[$1] = 1; next }
      /^#/ || ($1 in seen) { next }
      { seen[$1] = 1 }
      index(tolower($1 " " $4), tolower(s)) {
        split($2, z, "/")
        line = sprintf("%s %-21s %6s", ($1 in inst) ? "*" : " ", $1, h(z[2]))
        room = w - length(line) - 2
        if (room > 8 && $4 != "") line = line "  \033[90m" cut($4, room) "\033[0m"
        print line
        if (++n >= 60) exit
      }
    ' - $(files) ;;
  add)
    shift
    [ "$1" = -q ] && q=1 && shift
    [ $# -gt 0 ] || kt_usage "add [-q] <name>..."
    index
    want "$@"
    check "$list"
    new=$(echo "$list" | awk '$4 == 0')
    if [ -z "$new" ]; then
      remember "$@"
      clr
      [ -n "$q" ] || echo "уже установлено"
      exit 0
    fi
    [ -n "$q" ] || echo "$new" | total
    trap 'rm -f $T.*' EXIT
    for p in $(echo "$new" | cut -d" " -f1); do
      s=$(echo "$new" | awk -v p="$p" '$1 == p { print $5 }')
      [ -n "$q" ] || printf '  %-21s %6s%s' "$p" "$(echo "$new" | awk -v p="$p" "$H"'$1 == p { print h($2) }')" "${s:+  (apk)}"
      if [ -n "$s" ]; then
        apk "$s" $T.p.$p || fail "$p" $?
      else
        kt_get "$REPO/$p.tar.xz" $T.p.$p 2>/dev/null || fail "$p"
      fi
      [ -n "$q" ] || printf '\r+\n'
    done
    for p in $(echo "$new" | cut -d" " -f1); do
      if [ -n "$(echo "$new" | awk -v p="$p" '$1 == p { print $5 }')" ]; then
        tar -xzvf $T.p.$p -C / 2>/dev/null | grep -v '^\.' > $DB/$p
        if [ -f /.trigger ]; then
          mkdir -p $TRIG
          mv /.trigger $TRIG/$p
          sed -n 's/^triggers = //p' /.PKGINFO > $TRIG/$p.dirs
        fi
        rm -f /.PKGINFO /.SIGN.* /.pre-* /.post-* /.trigger
      else
        xz -dc $T.p.$p | tar -xvf - -C / > $DB/$p
      fi
      rm -f $T.p.$p
      if [ -x /var/lib/kt/post/$p ]; then
        clr
        /var/lib/kt/post/$p
      fi
    done
    remember "$@"
    fire $(echo "$new" | awk -v db=$DB '{ print db "/" $1 }')
    clr ;;
  rm)
    shift
    d= c= y=
    while :; do
      case "$1" in
        -[cdy]|-[cdy][cdy]|-[cdy][cdy][cdy])
          case "$1" in *c*) c=1 ;; esac
          case "$1" in *d*) d=1 ;; esac
          case "$1" in *y*) y=1 ;; esac ;;
        *) break ;;
      esac
      shift
    done
    [ $# -gt 0 ] || kt_usage "rm [-c] [-d] [-y] <name>..."
    case " $* " in *" $BASE "*) echo "kt pkg: $BASE удалить нельзя, это сама система" >&2; exit 1 ;; esac
    cut -f1 $IDX > /tmp/.kt-pkg.$$.idx 2>/dev/null
    if [ -s $AIDX ] || ls $DB | grep -qvxF -f /tmp/.kt-pkg.$$.idx; then alpine > /dev/null 2>&1 && ALP=1; fi
    rm -f /tmp/.kt-pkg.$$.idx
    list=$(awk -F'\t' -v inst="$(ls $DB | grep -vxF $BASE | tr '\n' ' ')" -v world="$(tr '\n' ' ' < $WORLD)" -v want="$*" -v d="$d" -v casc="$c" '
      /^#/ || ($1 in known) { next }
      { known[$1] = 1; deps[$1] = $3 }
      function choose(t, n, a, i) {
        n = split(t, a, "|")
        for (i = 1; i <= n; i++) if ((a[i] in I) && !(a[i] in Q)) return a[i]
        for (i = 1; i <= n; i++) if (a[i] in I) return a[i]
        return ""
      }
      function down(p, S, o, n, a, i, m, b, j) {
        if ((p in S) || !(p in I)) return
        S[p] = 1
        n = split(deps[p], a, " ")
        for (i = 1; i <= n; i++) { m = split(a[i], b, "|"); for (j = 1; j <= m; j++) down(b[j], S, o) }
        o[++o[0]] = p
      }
      function hold(p, M, X, n, a, i, c) {
        if ((p in M) || !(p in I) || (p in X)) return
        M[p] = 1
        n = split(deps[p], a, " ")
        for (i = 1; i <= n; i++) if ((c = choose(a[i])) != "") { why[c] = why[c] " " p; hold(c, M, X) }
      }
      function root(p, S) {
        return (p in W) || !(p in known) || !(p in S)
      }
      END {
        ni = split(inst, ii, " "); for (i = 1; i <= ni; i++) I[ii[i]] = 1
        n = split(world, a, " "); for (i = 1; i <= n; i++) W[a[i]] = 1
        n = split(want, a, " "); for (i = 1; i <= n; i++) if (!(a[i] in Q)) { Q[a[i]] = 1; q[++nq] = a[i] }
        if (casc) do {
          more = 0
          for (i = 1; i <= ni; i++) if (!(ii[i] in Q)) {
            n = split(deps[ii[i]], a, " ")
            for (j = 1; j <= n; j++) if (choose(a[j]) in Q) { Q[ii[i]] = 1; q[++nq] = ii[i]; more = 1; break }
          }
        } while (more)
        c[0] = 0
        if (d) for (i = 1; i <= nq; i++) down(q[i], C, c)
        else for (i = nq; i >= 1; i--) if (q[i] in I) { C[q[i]] = 1; c[++c[0]] = q[i] }
        for (i = 1; i <= ni; i++) if (!(ii[i] in Q) && root(ii[i], C)) hold(ii[i], K, G)
        for (i = 1; i <= nq; i++) {
          p = q[i]
          if (!(p in I)) print "?" p
          else if (p in K) print "!" p why[p]
        }
        for (i = c[0]; i >= 1; i--) if (!(c[i] in K)) { G[c[i]] = 1; print "-" c[i] }
        o[0] = 0
        for (i = 1; i <= c[0]; i++) if (c[i] in G) down(c[i], D, o)
        for (i = 1; i <= ni; i++) if (!(ii[i] in G) && root(ii[i], D)) hold(ii[i], R, G)
        for (i = 1; i <= o[0]; i++) if (!(o[i] in G) && !(o[i] in R)) {
          O[o[i]] = 1
          n = split(deps[o[i]], a, " ")
          for (j = 1; j <= n; j++) if ((x = choose(a[j])) != o[i]) U[x] = 1
        }
        for (k = 0; k < 2; k++) for (i = o[0]; i >= 1; i--) if ((o[i] in O) && !(o[i] in R) && (k || !(o[i] in U))) { print "+" o[i]; hold(o[i], R, G) }
      }
    ' $(files))
    echo "$list" | sed -n 's/^?\(.*\)/kt pkg: \1 не установлен/p; s/^!\([^ ]*\) /kt pkg: \1 нужен для /p' >&2
    gone=$(echo "$list" | sed -n 's/^-//p')
    if [ -n "$gone" ] && [ -z "$y" ]; then
      printf 'удалить %s? [y/N] ' "$(echo $gone)"
      read -r a || echo
      case "$a" in y|Y|yes|д|Д|да) ;; *) exit 1 ;; esac
    fi
    for p in $gone; do
      others=$(ls $DB | grep -vx "$p" | sed "s|^|$DB/|")
      { echo @; cat $others /dev/null; } | awk 'NR == FNR { k[$0]; next } !($0 in k)' - $DB/$p | sort -r | while read -r f; do
        if [ -d "/$f" ] && [ ! -L "/$f" ]; then rmdir "/$f" 2>/dev/null; else rm -f "/$f"; fi
      done
      cp $DB/$p /tmp/.kt-pkg.$$.rm.$p
      rm -f $DB/$p $TRIG/$p $TRIG/$p.dirs
      grep -vxF "$p" $WORLD > $WORLD.new; mv $WORLD.new $WORLD
      echo "- $p"
    done
    remember $(echo "$list" | sed -n 's/^+//p')
    set -- /tmp/.kt-pkg.$$.rm.*
    [ -f "$1" ] && fire "$@"
    rm -f /tmp/.kt-pkg.$$.rm.* ;;
  files)
    shift
    [ $# -gt 0 ] || kt_usage "files <name>..."
    for p in "$@"; do
      [ -f "$DB/$p" ] || { echo "kt pkg: $p не установлен" >&2; exit 1; }
    done
    for p in "$@"; do
      sed -n '/\/$/!s|^|/|p' "$DB/$p"
    done ;;
  -*) kt_usage "[search|add|rm|files] [name...]" ;;
  *)
    index
    want "$@"
    check "$list"
    echo "$list" | awk "$H"'{ printf "%s %-21s %6s %6s%s\n", $4 ? "*" : "+", $1, h($2), h($3), $5 != "" ? "  (apk)" : "" }'
    echo "$list" | total ;;
esac
