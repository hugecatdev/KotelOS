#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  установленные пакеты по алфавиту: размер, описание; (диск) - стоит на диске, (apk) - из Alpine
<name>...  что поставится, сколько займёт и сколько памяти свободно
search [-r] <word>  поиск по имени и описанию в репозитории и Alpine; -r - только в репозитории; * - установлен
add [-dqy] <name>...  установка с зависимостями: называет пакеты и размер, скачивает после ответа «да»; -d - на диск, -q - без списка, -y - без вопроса
пакеты ставятся в память машины; если в неё не влезет, add предложит диск
диск /mnt/browser - файлы в хранилище браузера, в памяти от них только ссылки; первый запуск программы с него медленнее
rm [-y] <name>...  удаление, зависимости остаются; -y - без вопроса
rm -d <name>...  удаление вместе с зависимостями, которые больше никому не нужны
rm -c <name>...  удаление вместе с пакетами, которым он нужен
files <name>...  файлы установленного пакета
репозиторий - kt cfg pkg.repo, на одну команду - KT_REPO=адрес kt pkg ...'
kt_meta "[<name>... | search | add | rm | files]" "пакеты" "$@"
REPO=${KT_REPO:-$(kt cfg pkg.repo 2>/dev/null)}
REPO=${REPO:-/repo}
DB=/var/lib/kt/pkg
BASE=base
IDX=/var/lib/kt/index
AIDX=/var/lib/kt/alpine
MIR=/var/lib/kt/mirror
RMIR=/var/lib/kt/mirror.relay
TRIG=/var/lib/kt/trigger
WORLD=/var/lib/kt/world
T=/tmp/.kt-pkg.$$
# память, КБ: файлы лежат в ОЗУ, корню не дают последние RESERVE (предел в S01mount); если после
# установки свободной останется меньше LOW, add спросит
RESERVE=16384
LOW=16384
# диск (DISK - 9p, файлы в OPFS браузера): add -d или когда в память не влезает - все новые пакеты
# команды распаковываются в DPKG, дерево как корень (программа, что ищет соседей от своего настоящего
# пути, как gcc, находит их там), а в корне от них папки и ссылки на файлы; это стоит ОЗУ, LINK КБ на
# мегабайт пакета. DSK - эта команда ставит на диск, DFREE - свободно на нём, КБ; отметки - в ONDISK
DISK=/mnt/browser
DPKG=$DISK/pkg
ONDISK=/var/lib/kt/disk
LINK=16
DSK=
DFREE=
q=
ALP=
DEAD=
# скачивание - с повтором: обрыв посреди большой установки (сотни мегабайт) не должен ронять её
# целиком. TRIES кругов по зеркалам Alpine (пакет репозитория - TRIES попыток), между ними пауза
TRIES=3
mkdir -p $DB
[ -f $WORLD ] || ls $DB | grep -vxF $BASE > $WORLD

clr() {
  [ -z "$q" ] || printf '\r\033[2K'
}

index() {
  if kt_get "$REPO/index.txt" $IDX.new 2>/dev/null; then
    mv $IDX.new $IDX
  elif [ ! -s $IDX ]; then
    clr
    kt_err "нет $REPO/index.txt"
    exit 1
  fi
}

alpine() {
  if [ -s $AIDX ] && [ -z "$(find $AIDX -mmin +1440 2>/dev/null)" ]; then return 0; fi
  if kt_get "$REPO/alpine.txt.gz" $AIDX.gz 2>/dev/null && gunzip -c $AIDX.gz > $AIDX.new 2>/dev/null; then
    mv $AIDX.new $AIDX
  fi
  rm -f $AIDX.gz $AIDX.new
  [ -s $AIDX ]
}

files() {
  echo $IDX
  [ -z "$ALP" ] || echo $AIDX
}

fire() {
  for d in $TRIG/*.dirs; do
    [ -f "$d" ] || continue
    t=${d%.dirs}
    hit=$(awk -v dirs="$(cat "$d")" 'BEGIN { n = split(dirs, w, " ") }
      { f = "/" $0; for (i = 1; i <= n; i++) { x = w[i]; sub(/\*$/, "", x); if (x != "" && index(f, x) == 1) got[w[i]] = 1 } }
      END { for (k in got) printf "%s ", k }' "$@" 2>/dev/null)
    [ -z "$hit" ] || ( cd / && sh "$t" $hit ) > /dev/null 2>&1
  done
}

installed() {
  echo @
  ls $DB
}

remember() {
  for p in "$@"; do grep -qxF "$p" $WORLD || echo "$p" >> $WORLD; done
}

width() {
  w=$(stty size 2>/dev/null | cut -d" " -f2)
  echo "${w:-80}"
}

L='NR == FNR { inst[$1] = 1; next }
/^#/ || ($1 in known) { next }
{
  known[$1] = 1
  src[$1] = $6
  sum[$1] = $7
  split($2, s, "/")
  dl[$1] = s[1] + 0
  mem[$1] = s[2] + 0
  deps[$1] = $3
  desc[$1] = $4
}'
H='function h(k) { return k >= 1024 ? sprintf("%.1fM", k / 1024) : k "K" }'
U='function len(s, t) { t = s; return length(s) - gsub(/[\200-\277]/, "", t) }
function cut(s, n, i, c) {
  for (i = 1; i <= length(s); i++) if (substr(s, i, 1) !~ /[\200-\277]/ && ++c > n) return substr(s, 1, i - 1)
  return s
}'
K='function ondisk(p, a, n, i) {
  if (!dn) { dn = split(dk, a, " ") + 1; for (i = 1; i < dn; i++) DK[a[i]] = 1 }
  return p in DK
}'
A='function pick(t, n, a, i) {
  n = split(t, a, "|")
  for (i = 1; i <= n; i++) if ((a[i] in inst) || (a[i] in W) || (a[i] in seen)) return a[i]
  return a[1]
}'

plan() {
  installed | awk -F'\t' -v want="$*" "$L$A"'
    function visit(p, n, a, i) {
      if (p in seen) return
      seen[p] = 1
      if (!(p in known)) { print "?" p; return }
      n = split(deps[p], a, " ")
      for (i = 1; i <= n; i++) visit(pick(a[i]))
      print p, dl[p], mem[p], (p in inst) ? 1 : 0, src[p], sum[p]
    }
    END {
      n = split(want, w, " ")
      for (i = 1; i <= n; i++) W[w[i]] = 1
      for (i = 1; i <= n; i++) visit(w[i])
    }
  ' - $(files)
}

want() {
  list=$(plan "$@")
  if echo "$list" | grep -q '^?' && alpine; then
    ALP=1
    list=$(plan "$@")
  fi
}

check() {
  bad=$(echo "$1" | sed -n 's/^?//p')
  [ -z "$bad" ] || { clr; kt_die "нет пакета" $bad; }
}

total() {
  awk -v free="$(room)" -v dsk="$DSK" -v link=$LINK -v dfree="$DFREE" "$H"'
    $4 == 0 { n++; dl += $2; if (dsk) { dk += $3; mem += int($3 * link / 1024) } else mem += $3 }
    END {
      if (!n) exit
      if (free < 0) free = 0
      if (dsk) printf "пакетов: %d, скачать %s, на диске %s, в памяти %s; свободно на диске %s, в памяти %s\n", n, h(dl), h(dk), h(mem), h(dfree), h(free)
      else printf "пакетов: %d, скачать %s, в памяти %s, свободно %s\n", n, h(dl), h(mem), h(free)
    }
  '
}

# диск для больших пакетов: смонтирован 9p и у страницы есть OPFS; DFREE - свободно на нём, КБ;
# нет - NODISK, почему
disk() {
  NODISK="диск $DISK не подключён: машина сохранена до его появления, новая - kt reset"
  grep -q "^host9p $DISK 9p " /proc/mounts || return 1
  NODISK="диска $DISK нет: браузер не даёт хранилище этой странице (открыта из файла или по http не с localhost)"
  DFREE=$(kt_js 'navigator.storage.getDirectory().then(() => navigator.storage.estimate()).then((e) => Math.floor((e.quota - e.usage) / 1024), () => "")' 2>/dev/null)
  [ -n "$DFREE" ]
}

# пакеты этой команды ставятся на диск
ondisk() {
  [ -n "$DSK" ]
}

# куда скачать архив пакета: большой - сразу на диск, через ОЗУ он идёт по одному
arc() {
  if ondisk "$1"; then echo $DPKG/.dl.$$/$1; else echo $T.p.$1; fi
}

# пакет с диска - в корень по своему списку: папки настоящие, на файлы - ссылки, ссылки пакета - как
# есть (относительная смотрит от своего места в корне). Ссылки на файлы - cp -s по папкам: процесс на
# каждую стоил бы секунды на сотню
link() {
  while IFS= read -r f; do
    f=${f%/}
    if [ -z "$f" ]; then continue
    elif [ -L "$DPKG/$f" ]; then echo "s $f"
    elif [ -d "$DPKG/$f" ]; then echo "d $f"
    elif [ -e "$DPKG/$f" ]; then echo "f $f"
    fi
  done < $DB/$1 > $T.k
  cd / || return 1
  sed -n 's/^d //p' $T.k | sed 's/./\\&/g' | xargs -r mkdir -p || return 1
  sed -n 's/^s //p' $T.k > $T.s
  if [ -s $T.s ]; then
    sed 's/./\\&/g' $T.s | xargs rm -f
    ( cd $DPKG && tar -cf - -T $T.s ) | tar -xf - || return 1
  fi
  sed -n 's/^f //p' $T.k | awk -v src=$DPKG -v sq="'" '
    function q(s) { gsub(sq, sq "\\" sq sq, s); return sq s sq }
    {
      d = $0
      if (!sub(/\/[^\/]*$/, "", d)) d = ""
      if (d != last || n == 100) { if (n) print " " q("/" last); printf "cp -sf"; n = 0; last = d }
      printf " %s", q(src "/" $0)
      n++
    }
    END { if (n) print " " q("/" last) }' | sh -e
}

# сколько памяти можно занять файлами, КБ: свободная без запаса корня
room() {
  awk -v r=$RESERVE '/^MemAvailable:/ { print $2 - r }' /proc/meminfo
}

# пик памяти при установке и сколько её займут пакеты, КБ: сначала скачиваются все архивы (на диск
# архив идёт через ОЗУ по одному), потом распаковываются по одному, архив удаляется после своей
# распаковки; пакет на диске стоит в ОЗУ только папок и ссылок
peak() {
  awk -v dsk="$DSK" -v link=$LINK '
    $4 == 0 { n++; dl[n] = $2; mem[n] = $3 }
    END {
      for (i = 1; i <= n; i++) if (dsk) { if (dl[i] > p) p = dl[i] } else { got += dl[i]; if (got > p) p = got }
      left = got
      got = 0
      for (i = 1; i <= n; i++) {
        got += dsk ? int(mem[i] * link / 1024) : mem[i]
        if (got + left > p) p = got + left
        if (!dsk) left -= dl[i]
      }
      print p + 0, got + 0
    }'
}

# сколько займут на диске пакеты и архив, что распаковывается, КБ
dneed() {
  awk '$4 == 0 { s += $3; if ($2 > a) a = $2 } END { print s + a }'
}

kb() {
  kt_size $(($1 > 0 ? $1 * 1024 : 0))
}

# файлы пакета $1, которых нет в списках пакетов $2 (каталог с их именами), удалить из корня $3:
# сначала файлы, потом папки, вложенные раньше своих, пачками (процесс на файл - секунды на сотню)
unown() {
  others=$(ls $2 | grep -vxF "$1" | sed "s|^|$DB/|")
  { echo @; cat $others /dev/null; } | awk 'NR == FNR { k[$0]; next } !($0 in k)' - $DB/$1 | sort -r | while IFS= read -r f; do
    f=${f%/}
    if [ -d "$3/$f" ] && [ ! -L "$3/$f" ]; then echo "d $3/$f"; elif [ -n "$f" ]; then echo "f $3/$f"; fi
  done > $T.u
  sed -n 's/^f //p' $T.u | sed 's/./\\&/g' | xargs -r rm -f
  sed -n 's/^d //p' $T.u | sed 's/./\\&/g' | xargs -r rmdir 2>/dev/null
  rm -f $T.u
}

# удалить файлы пакета, которых нет у других, и записи о нём; у пакета на диске - и там, сверяя с
# другими пакетами диска
wipe() {
  unown "$1" $DB ""
  [ ! -f $ONDISK/$1 ] || unown "$1" $ONDISK $DPKG
  rm -f $DB/$1 $TRIG/$1 $TRIG/$1.dirs $ONDISK/$1
}

mirrors() {
  awk -F'\t' -v m="$(cat $MIR 2>/dev/null)" '
    !/^#/ { exit }
    /^#mirror/ { if ($2 == m) print $2; else l = l $2 "\n" }
    END { printf "%s", l }
  ' $AIDX
}

# сеть с релеем (kt net): пакет Alpine качает сама машина, напрямую с быстрого зеркала, CORS не нужен.
# busybox wget без TLS - зеркала по http (строки #relay индекса), поэтому пакет сверяется с суммой из
# индекса (он пришёл по https): управляющая часть .apk (второй поток gzip) - с SHA1 из APKINDEX (C:),
# данные (третий) - с datahash из неё. Не скачался или не сошлось - как без релея, через браузер
relay_on() {
  [ -z "$RCHK" ] || return $RELAY
  RCHK=1
  RELAY=1
  RV=$(kt cfg net.relay 2> /dev/null)
  case $RV in ws://* | wss://* | wisp://* | wisps://*) RELAY=0 ;; esac
  return $RELAY
}

# зеркала для релея, быстрейшее первым: замер один раз на релей (первая строка $RMIR - он)
relays() {
  if [ "$(head -1 $RMIR 2> /dev/null)" != "$RV" ]; then
    {
      echo "$RV"
      awk -F'\t' '!/^#/ { exit } /^#relay/ { print $2 }' $AIDX | while read -r m; do
        read -r t0 _ < /proc/uptime
        busybox wget -q --spider -T 5 "$m/main/x86/APKINDEX.tar.gz" 2> /dev/null || continue
        read -r t1 _ < /proc/uptime
        echo "$t0 $t1 $m"
      done | awk '{ print $2 - $1, $3 }' | sort -n | cut -d" " -f2
    } > $RMIR
  fi
  tail -n +2 $RMIR
}

# apkcheck файл Q1...: начала потоков gzip (1f 8b 08) в первых 64 КБ - кандидаты границ; пара, на
# которой сходится SHA1 управляющей части, и datahash данных за ней - пакет тот самый
apkcheck() {
  want=$(echo "${2#Q1}" | base64 -d 2> /dev/null | od -An -tx1 -v | tr -d ' \n')
  [ -n "$want" ] || return 1
  f=$1
  set -- $(head -c 65536 "$f" | od -An -tx1 -v | awk '
    { for (i = 1; i <= NF; i++) { if (b2 == "1f" && b1 == "8b" && $i == "08") print k - 2; b2 = b1; b1 = $i; k++ } }')
  for c in "$@"; do
    for d in "$@"; do
      [ "$d" -gt "$c" ] || continue
      [ "$(tail -c +$((c + 1)) "$f" | head -c $((d - c)) | sha1sum | cut -d" " -f1)" = "$want" ] || continue
      h=$(tail -c +$((c + 1)) "$f" | head -c $((d - c)) | gunzip -c 2> /dev/null | tar -xOf - .PKGINFO 2> /dev/null |
        sed -n 's/^datahash = //p')
      [ -n "$h" ] && [ "$(tail -c +$((d + 1)) "$f" | sha256sum | cut -d" " -f1)" = "$h" ]
      return
    done
  done
  return 1
}

# apk_relay путь файл сумма: с зеркал релея по очереди
apk_relay() {
  [ -n "$3" ] || return 1
  for m in $(relays); do
    if e=$(busybox wget -q -T 20 -O "$2" "$m/$1" 2>&1); then
      apkcheck "$2" "$3" && return 0
      e="не сошлась контрольная сумма"
    fi
    echo "${e#wget: }" > "$(errf "$m")"
  done
  return 1
}

# последняя ошибка источника - в файле: errf источник; why ошибка адрес - что ответил источник
errf() {
  echo "$T.err.$(echo "$1" | tr -c 'a-zA-Z0-9\n' _)"
}
why() {
  w=${1#*"$2: "}
  case $w in *"Failed to fetch"*) w="нет связи (сеть или CORS)" ;; esac
  echo "$w"
}

apk_once() {
  d=${1%/*}
  n=${1##*/}
  n=${n%-*-r*.apk}
  for m in $(mirrors); do
    case " $DEAD " in *" $m "*) continue ;; esac
    if e=$(kt_get "$m/$1" "$2" 2>&1); then
      echo "$m" > $MIR
      return 0
    fi
    why "$e" "$m/$1" > "$(errf "$m")"
    case "$e" in
      *": 404"*) ;;
      *) DEAD="$DEAD $m"; continue ;;
    esac
    i=$T.i.$(echo "$m/$d" | tr -c 'a-zA-Z0-9\n' _)
    if [ ! -f $i ] && ! e=$(kt_get "$m/$d/APKINDEX.tar.gz" $i 2>&1); then
      why "$e" "$m/$d/APKINDEX.tar.gz" > "$(errf "$m")"
      continue
    fi
    v=$(tar -xzOf $i APKINDEX 2>/dev/null | awk -v n="$n" '/^P:/ { p = substr($0, 3) } /^V:/ && p == n { print substr($0, 3); exit }')
    [ -n "$v" ] || { echo "нет $n в $d/APKINDEX.tar.gz" > "$(errf "$m")"; continue; }
    if e=$(kt_get "$m/$d/$n-$v.apk" "$2" 2>&1); then
      echo "$m" > $MIR
      return 0
    fi
    why "$e" "$m/$d/$n-$v.apk" > "$(errf "$m")"
  done
  return 1
}

# apk путь файл сумма: с релеем - сначала его зеркала, потом браузер; круг по зеркалам, не вышло - через
# паузу ещё круг, и отказавшие зеркала - снова в деле
apk() {
  r=1
  while :; do
    if relay_on && apk_relay "$1" "$2" "$3"; then return 0; fi
    apk_once "$1" "$2" && return 0
    [ $r -lt $TRIES ] || return 1
    DEAD=
    sleep $((r * 3))
    r=$((r + 1))
  done
}

# repo_get пакет файл: пакет из репозитория KotelOS, с повтором
repo_get() {
  r=1
  until e=$(kt_get "$REPO/$1.tar.xz" "$2" 2>&1); do
    why "$e" "$REPO/$1.tar.xz" > "$(errf "$REPO")"
    [ $r -lt $TRIES ] || return 1
    sleep $((r * 3))
    r=$((r + 1))
  done
}

# fail пакет: не скачался - и что ответил каждый источник (зеркала Alpine или репозиторий) в последний раз
fail() {
  if [ -n "$q" ]; then clr; else printf '\r!\n'; fi
  kt_err "не скачать $1"
  for m in $(tail -n +2 $RMIR 2> /dev/null) $(mirrors 2> /dev/null) "$REPO"; do
    f=$(errf "$m")
    [ ! -f "$f" ] || printf '  %s: %s\n' "$m" "$(cat "$f")" >&2
  done
  exit 1
}

case "$1" in
  "")
    # все установленные по алфавиту: свой размер у каждого, итог - последней строкой
    index
    cut -f1 $IDX > $T.idx 2>/dev/null
    if ls $DB | grep -qvxF -f $T.idx && alpine; then ALP=1; fi
    rm -f $T.idx
    installed | awk -F'\t' -v w="$(width)" -v dk="$(ls $ONDISK 2>/dev/null | tr '\n' ' ')" "$L$H$U$K"'
      { order[++no] = $1 }
      function show(p, m, line, room, d) {
        m = (src[p] != "" ? "  (apk)" : "") (ondisk(p) ? "  (диск)" : "")
        line = sprintf("%-" nw "s %6s", p, h(mem[p]))
        room = w - length(line) - 2 - length(m)
        d = room > 8 ? cut(desc[p], room) : ""
        print line (d != "" ? "  " d : "") m | "sort"
        n++
        if (ondisk(p)) tdk += mem[p]; else tmem += mem[p]
      }
      END {
        nw = 12
        delete inst["@"]
        for (p in inst) if (len(p) > nw) nw = len(p)
        for (i = 1; i <= no; i++) if (order[i] in inst) { show(order[i]); done[order[i]] = 1 }
        for (p in inst) if (!(p in done)) { print p | "sort"; n++ }
        close("sort")
        printf "пакетов: %d, в памяти %s%s\n", n, h(tmem), tdk ? ", на диске " h(tdk) : ""
      }
    ' - $(files) ;;
  search)
    shift
    r=
    while getopts :r opt; do
      case $opt in
        r) r=1 ;;
        *) kt_usage "search [-r] <word>" ;;
      esac
    done
    shift $((OPTIND - 1))
    [ $# -eq 1 ] && [ -n "$1" ] || kt_usage "search [-r] <word>"
    index
    if [ -z "$r" ] && alpine; then ALP=1; fi
    installed | awk -F'\t' -v w="$(width)" -v s="$1" "$H$U"'
      NR == FNR { inst[$1] = 1; next }
      /^#/ || ($1 in seen) { next }
      { seen[$1] = 1 }
      index(tolower($1 " " $4), tolower(s)) {
        split($2, z, "/")
        line = sprintf("%s %-21s %6s", ($1 in inst) ? "*" : " ", $1, h(z[2]))
        room = w - length(line) - 2
        if (room > 8 && $4 != "") line = line "  \033[90m" cut($4, room) "\033[0m"
        print line
        if (++n >= 60) exit
      }
    ' - $(files) ;;
  add)
    shift
    y=
    while getopts :dqy opt; do
      case $opt in
        d) DSK=1 ;;
        q) q=1 ;;
        y) y=1 ;;
        *) kt_usage "add [-dqy] <name>..." ;;
      esac
    done
    shift $((OPTIND - 1))
    [ $# -gt 0 ] || kt_usage "add [-dqy] <name>..."
    if [ -n "$DSK" ] && ! disk; then kt_die "$NODISK"; fi
    index
    want "$@"
    check "$list"
    new=$(echo "$list" | awk '$4 == 0')
    if [ -z "$new" ]; then
      remember "$@"
      clr
      [ -n "$q" ] || echo "уже установлено"
      exit 0
    fi
    free=$(room)
    read -r need used <<EOF
$(echo "$new" | peak)
EOF
    # в память не влезет - на диск, если он есть
    ask="установить?"
    if [ -z "$DSK" ] && [ "$need" -gt "$free" ]; then
      disk || { clr; kt_die "не хватит памяти: нужно $(kb $need) вместе с архивами, свободно $(kb $free)"; }
      ask="в память не влезет: нужно $(kb $need) вместе с архивами, свободно $(kb $free). установить на диск $DISK?"
      DSK=1
      read -r need used <<EOF
$(echo "$new" | peak)
EOF
    fi
    left=$((free - used))
    if [ "$need" -gt "$free" ]; then
      clr
      kt_die "не хватит памяти: нужно $(kb $need) вместе с архивами, свободно $(kb $free)"
    fi
    if [ -n "$DSK" ] && [ "$(echo "$new" | dneed)" -gt "$DFREE" ]; then
      clr
      kt_die "не хватит места на диске: нужно $(kb $(echo "$new" | dneed)), свободно $(kb $DFREE)"
    fi
    if [ $left -lt $LOW ]; then
      ask="свободной памяти останется $(kb $left), программам её может не хватить. установить?"
    fi
    # что поставится - до вопроса, скачивание - после ответа
    clr
    [ -n "$q" ] || echo "$new" | awk -v w="$(width)" '
      { if (n && n + length($1) + 1 > w) { printf "\n"; n = 0 } if (!n) { printf " "; n = 1 } printf " %s", $1; n += length($1) + 1 }
      END { printf "\n" }'
    [ -n "$q" ] && [ -n "$y" ] || echo "$new" | total
    [ -n "$y" ] || kt_ask "$ask" || exit 1
    trap 'rm -rf $T.* $DPKG/.dl.$$' EXIT
    [ -z "$DSK" ] || mkdir -p $DPKG/.dl.$$ $ONDISK
    for p in $(echo "$new" | cut -d" " -f1); do
      s=$(echo "$new" | awk -v p="$p" '$1 == p { print $5 }')
      c=$(echo "$new" | awk -v p="$p" '$1 == p { print $6 }')
      [ -n "$q" ] || printf '  %-21s %6s%s' "$p" "$(echo "$new" | awk -v p="$p" "$H"'$1 == p { print h($2) }')" "${s:+  (apk)}"
      if [ -n "$s" ]; then
        apk "$s" "$(arc $p)" "$c" || fail "$p"
      else
        repo_get "$p" "$(arc $p)" || fail "$p"
      fi
      [ -n "$q" ] || printf '\r+\n'
    done
    put=
    for p in $(echo "$new" | cut -d" " -f1); do
      a=$(arc $p)
      r=/
      if ondisk; then r=$DPKG; fi
      if [ -n "$(echo "$new" | awk -v p="$p" '$1 == p { print $5 }')" ]; then
        tar -xzvf $a -C $r > $T.l 2> $T.e
        ok=$?
        grep -v '^\.' $T.l > $DB/$p
        if [ -f $r/.trigger ]; then
          mkdir -p $TRIG
          mv $r/.trigger $TRIG/$p
          sed -n 's/^triggers = //p' $r/.PKGINFO > $TRIG/$p.dirs
        fi
        rm -f $r/.PKGINFO $r/.SIGN.* $r/.pre-* $r/.post-* $r/.trigger
      else
        xz -dc $a | tar -xvf - -C $r > $DB/$p 2> $T.e
        ok=$?
      fi
      rm -f $a $T.l
      put="$p $put"
      if [ $ok = 0 ] && [ $r != / ]; then
        : > $ONDISK/$p
        link $p 2>> $T.e || ok=1
      fi
      # не распаковался (кончилось место) - убрать всё, что поставлено этой командой
      if [ $ok != 0 ]; then
        clr
        cat $T.e >&2
        for x in $put; do wipe $x; done
        kt_die "не распаковать $p, установка отменена"
      fi
      if [ -x /var/lib/kt/post/$p ]; then
        clr
        /var/lib/kt/post/$p
      fi
    done
    remember "$@"
    fire $(echo "$new" | awk -v db=$DB '{ print db "/" $1 }')
    clr ;;
  rm)
    shift
    d= c= y=
    while getopts :cdy opt; do
      case $opt in
        c) c=1 ;;
        d) d=1 ;;
        y) y=1 ;;
        *) kt_usage "rm [-cdy] <name>..." ;;
      esac
    done
    shift $((OPTIND - 1))
    [ $# -gt 0 ] || kt_usage "rm [-cdy] <name>..."
    case " $* " in *" $BASE "*) kt_die "$BASE удалить нельзя, это сама система" ;; esac
    cut -f1 $IDX > /tmp/.kt-pkg.$$.idx 2>/dev/null
    if [ -s $AIDX ] || ls $DB | grep -qvxF -f /tmp/.kt-pkg.$$.idx; then alpine > /dev/null 2>&1 && ALP=1; fi
    rm -f /tmp/.kt-pkg.$$.idx
    list=$(awk -F'\t' -v inst="$(ls $DB | grep -vxF $BASE | tr '\n' ' ')" -v world="$(tr '\n' ' ' < $WORLD)" -v want="$*" -v d="$d" -v casc="$c" '
      /^#/ || ($1 in known) { next }
      { known[$1] = 1; deps[$1] = $3 }
      function choose(t, n, a, i) {
        n = split(t, a, "|")
        for (i = 1; i <= n; i++) if ((a[i] in I) && !(a[i] in Q)) return a[i]
        for (i = 1; i <= n; i++) if (a[i] in I) return a[i]
        return ""
      }
      function down(p, S, o, n, a, i, m, b, j) {
        if ((p in S) || !(p in I)) return
        S[p] = 1
        n = split(deps[p], a, " ")
        for (i = 1; i <= n; i++) { m = split(a[i], b, "|"); for (j = 1; j <= m; j++) down(b[j], S, o) }
        o[++o[0]] = p
      }
      function hold(p, M, X, n, a, i, c) {
        if ((p in M) || !(p in I) || (p in X)) return
        M[p] = 1
        n = split(deps[p], a, " ")
        for (i = 1; i <= n; i++) if ((c = choose(a[i])) != "") { why[c] = why[c] " " p; hold(c, M, X) }
      }
      function root(p, S) {
        return (p in W) || !(p in known) || !(p in S)
      }
      END {
        ni = split(inst, ii, " "); for (i = 1; i <= ni; i++) I[ii[i]] = 1
        n = split(world, a, " "); for (i = 1; i <= n; i++) W[a[i]] = 1
        n = split(want, a, " "); for (i = 1; i <= n; i++) if (!(a[i] in Q)) { Q[a[i]] = 1; q[++nq] = a[i] }
        if (casc) do {
          more = 0
          for (i = 1; i <= ni; i++) if (!(ii[i] in Q)) {
            n = split(deps[ii[i]], a, " ")
            for (j = 1; j <= n; j++) if (choose(a[j]) in Q) { Q[ii[i]] = 1; q[++nq] = ii[i]; more = 1; break }
          }
        } while (more)
        c[0] = 0
        if (d) for (i = 1; i <= nq; i++) down(q[i], C, c)
        else for (i = nq; i >= 1; i--) if (q[i] in I) { C[q[i]] = 1; c[++c[0]] = q[i] }
        for (i = 1; i <= ni; i++) if (!(ii[i] in Q) && root(ii[i], C)) hold(ii[i], K, G)
        for (i = 1; i <= nq; i++) {
          p = q[i]
          if (!(p in I)) print "?" p
          else if (p in K) print "!" p why[p]
        }
        for (i = c[0]; i >= 1; i--) if (!(c[i] in K)) { G[c[i]] = 1; print "-" c[i] }
        o[0] = 0
        for (i = 1; i <= c[0]; i++) if (c[i] in G) down(c[i], D, o)
        for (i = 1; i <= ni; i++) if (!(ii[i] in G) && root(ii[i], D)) hold(ii[i], R, G)
        for (i = 1; i <= o[0]; i++) if (!(o[i] in G) && !(o[i] in R)) {
          O[o[i]] = 1
          n = split(deps[o[i]], a, " ")
          for (j = 1; j <= n; j++) if ((x = choose(a[j])) != o[i]) U[x] = 1
        }
        for (k = 0; k < 2; k++) for (i = o[0]; i >= 1; i--) if ((o[i] in O) && !(o[i] in R) && (k || !(o[i] in U))) { print "+" o[i]; hold(o[i], R, G) }
      }
    ' $(files))
    echo "$list" | sed -n 's/^?\(.*\)/kt pkg: \1 не установлен/p; s/^!\([^ ]*\) /kt pkg: \1 нужен для /p' >&2
    gone=$(echo "$list" | sed -n 's/^-//p')
    if [ -n "$gone" ] && [ -z "$y" ]; then
      kt_ask "удалить $(echo $gone)?" || exit 1
    fi
    for p in $gone; do
      cp $DB/$p /tmp/.kt-pkg.$$.rm.$p
      wipe $p
      grep -vxF "$p" $WORLD > $WORLD.new; mv $WORLD.new $WORLD
      echo "- $p"
    done
    remember $(echo "$list" | sed -n 's/^+//p')
    set -- /tmp/.kt-pkg.$$.rm.*
    [ -f "$1" ] && fire "$@"
    rm -f /tmp/.kt-pkg.$$.rm.* ;;
  files)
    shift
    [ $# -gt 0 ] || kt_usage "files <name>..."
    for p in "$@"; do
      [ -f "$DB/$p" ] || kt_die "$p не установлен"
    done
    for p in "$@"; do
      sed -n '/\/$/!s|^|/|p' "$DB/$p"
    done ;;
  -*) kt_usage "[<name>... | search | add | rm | files]" ;;
  *)
    index
    want "$@"
    check "$list"
    echo "$list" | awk "$H"'{ printf "%s %-21s %6s %6s%s\n", $4 ? "*" : "+", $1, h($2), h($3), $5 != "" ? "  (apk)" : "" }'
    echo "$list" | total
    need=$(echo "$list" | peak)
    if [ "${need% *}" -gt "$(room)" ] && disk; then
      echo "в память не влезет, на диске $DISK свободно $(kb $DFREE): kt pkg add -d $*"
    fi ;;
esac
