#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='dir  каталог назначения, по умолчанию текущий'
kt_meta "[dir]" "файлы из браузера" "$@"
dir=$(realpath "${1:-.}" 2>/dev/null)
[ -d "$dir" ] || { echo "kt up: нет папки ${1:-.}" >&2; exit 1; }
[ -w "$dir" ] || { echo "kt up: нельзя писать в $dir" >&2; exit 1; }
rm -f $KT_RUN/upload.done
echo "$dir" > $KT_RUN/upload.dir
trap 'rm -f $KT_RUN/upload.dir "$KT_REPLY" "$KT_REPLY.part"; echo; exit 130' INT TERM
echo "выбери файлы в браузере (Ctrl+C - отмена)"
kt_send upload ""
rm -f "$KT_REPLY"
while [ ! -f $KT_RUN/upload.done ]; do usleep 200000; done
if [ -s $KT_RUN/upload.done ]; then
  while IFS= read -r f; do
    [ -n "$f" ] && printf '%s (%s байт)\n' "$f" "$(wc -c < "$f")"
  done < $KT_RUN/upload.done
fi
rm -f $KT_RUN/upload.done
