#!/bin/sh
# udhcpc для kt net: адрес в сети релея Ethernet - вторым на eth0 (метка eth0:wan), маршрут по
# умолчанию и DNS - его; 192.168.86.100 (связь со страницей) не трогается
case $1 in
  deconfig)
    ip addr flush dev eth0 label eth0:wan
    ;;
  bound | renew)
    ip addr flush dev eth0 label eth0:wan
    ip addr add "$ip/${mask:-24}" dev eth0 label eth0:wan
    [ -z "$router" ] || ip route replace default via "${router%% *}" dev eth0
    if [ -n "$dns" ]; then
      for d in $dns; do echo "nameserver $d"; done > /etc/resolv.conf
    fi
    ;;
esac
exit 0
