#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='text     текст вопроса
default  начальное значение'
kt_meta "<text> [default]" "ввод строки" "$@"
[ $# -gt 0 ] || kt_usage "<text> [default]"
r=$(kt js "(t, d) => { const v = prompt(t, d); if (v === null) throw new Error('отменено'); return v }" "$1" "$2" 2>&1) || {
  [ "$r" = "Error: отменено" ] || echo "kt prompt: ${r#Error: }" >&2
  exit 1
}
printf '%s\n' "$r"
