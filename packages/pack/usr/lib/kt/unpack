#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='<name>  распаковать архив по исходным путям
<name> <dir>  распаковать в каталог dir
существующие файлы перезаписываются, остальные не удаляются; архивы - kt pack'
kt_meta "<name> [<dir>]" "архив из хранилища браузера в машину" "$@"
[ $# -ge 1 ] && [ $# -le 2 ] || kt_usage "<name> [<dir>]"
kt_name "$1"
T=$KT_RUN/unpack.$$.tgz
trap 'rm -f "$T"' EXIT
origin=$(kt_js "async (n, p) => { $(cat /usr/lib/kt-pack.js)
  const x = await get(n); await kt.write(p, x.blob); return x.origin }" "$1" "$T") || exit 1
case "$2" in
  "") to=$origin ;;
  /*) to=$2 ;;
  *) to=$PWD/$2 ;;
esac
mkdir -p "$to" && tar -xzf "$T" -C "$to" || exit 1
echo "$(kt_files "$(tar -tzf "$T" | grep -vc '/$')") -> $to"
