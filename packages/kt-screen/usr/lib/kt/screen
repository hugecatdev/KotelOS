#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов   on - экран на виду, off - спрятан
on               показать экран поверх терминала: клавиатура и мышь - в машину
off              спрятать, обратно в терминал
size             размер для X (startx): WxH под место на странице, видеопамять и screen.scale'
kt_meta "[on | off | size]" "экран /dev/fb0" "$@"
case $1 in
  ""|on|off|size) ;;
  *) kt_usage "[on | off | size]" ;;
esac
kt_send js "$(kt_b64 '(a) => kt.screen(a)') $(kt_b64 "$1")"
kt_status 6000
