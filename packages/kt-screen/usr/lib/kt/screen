#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  виден ли экран: on или off
on  показать экран поверх терминала: клавиатура и мышь - в машину
off  спрятать, обратно в терминал
size  размер экрана под страницу, WxH'
kt_meta "[on | off | size]" "экран машины" "$@"
case $1 in
  ""|on|off|size) [ $# -le 1 ] || kt_usage "[on | off | size]" ;;
  *) kt_usage "[on | off | size]" ;;
esac
kt_js '(a) => kt.screen(a)' "$1"
