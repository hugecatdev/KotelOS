#!/usr/bin/python3.12
import gc
gc.disable()
import array
import atexit
import builtins
import fcntl
import importlib.machinery
import importlib.util
import io
import os
import runpy
import select
import signal
import site
import socket
import subprocess
import sys
import threading
import time
import types

RUN = "/run/pyzygote"
SOCK = RUN + "/sock"
CLIENT = "/usr/local/bin/python3"
PRE = ("json re subprocess pathlib argparse datetime collections functools itertools typing dataclasses enum shutil "
       "tempfile textwrap base64 hashlib struct random math string glob fnmatch copy traceback warnings contextlib").split()
HERE = os.path.abspath(__file__)
CONF = "/etc/pyzygote.d"
PROFILE = "/etc/profile.d"
ENV = []
FILES = []
WATCH = []
HOOKS = []


def groups():
    out = []
    try:
        names = sorted(os.listdir(CONF))
    except OSError:
        return out
    for name in names:
        g = {"import": [], "fork": [], "env": [], "file": []}
        try:
            with open(os.path.join(CONF, name)) as f:
                for line in f:
                    w = line.partition("#")[0].split()
                    if w and w[0] in g:
                        g[w[0]] += w[1:]
            if g["import"] and all(importlib.util.find_spec(m.partition(".")[0]) for m in g["import"]):
                out.append(g)
        except (OSError, ValueError, ImportError):
            pass
    return out


def pick(env, pats):
    out = {}
    for p in pats:
        if p.endswith(b"*"):
            out.update((k, v) for k, v in env.items() if k.startswith(p[:-1]))
        elif p in env:
            out[p] = env[p]
    return out


def shell():
    try:
        out = subprocess.run(["/bin/sh", "-c", 'for f in %s/*.sh; do . "$f"; done > /dev/null 2>&1; exec env -0' % PROFILE],
                             stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
    except OSError:
        return {}
    return dict(e.partition(b"=")[::2] for e in out.split(b"\0") if b"=" in e)


def warm():
    todo = groups()
    pats = [p.encode() for g in todo for p in g["env"]]
    if pats:
        want = pick(shell(), pats)
        for k in pick(os.environb, pats):
            if k not in want:
                del os.environb[k]
        os.environb.update(want)
    for g in todo:
        local = [p for p in g["file"] if not p.startswith(("/", "~"))]
        if any(os.path.exists(p) for p in local):
            continue
        ENV.extend(p.encode() for p in g["env"])
        FILES.extend(os.fsencode(p) for p in local)
        WATCH.extend(os.path.expanduser(p) for p in g["file"] if p not in local)
        try:
            for m in g["import"]:
                importlib.import_module(m)
            for h in g["fork"]:
                mod, _, name = h.rpartition(".")
                hook = getattr(importlib.import_module(mod), name)
                if hook not in HOOKS:
                    HOOKS.append(hook)
        except Exception:
            pass


def state():
    out = []
    try:
        conf = [os.path.join(CONF, n) for n in sorted(os.listdir(CONF))]
    except OSError:
        conf = []
    for p in [p for p in sys.path if p] + [site.getusersitepackages(), sys.executable, CLIENT, HERE, CONF, PROFILE] + conf + WATCH:
        try:
            st = os.stat(p)
            out.append((p, st.st_mtime_ns, st.st_ino))
        except OSError:
            out.append((p, None))
    return out


def receive(conn):
    conn.settimeout(5)
    fds = array.array("i")
    msg, anc, _, _ = conn.recvmsg(65536, socket.CMSG_SPACE(3 * fds.itemsize))
    for level, kind, data in anc:
        if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
            fds.frombytes(data[:len(data) - len(data) % fds.itemsize])
    fds = list(fds)
    n = int.from_bytes(msg[:4], "little") if len(msg) >= 4 else -1
    data = msg[4:]
    while 0 <= len(data) < n:
        chunk = conn.recv(n - len(data))
        if not chunk:
            break
        data += chunk
    if len(fds) != 3 or len(data) != n:
        return fds, None
    f = data.split(b"\0")
    argc = int(f[2])
    return fds, (f[0], int(f[1], 8), f[3:3 + argc], [e for e in f[3 + argc:] if e])


def ctype(env):
    v = env.get(b"LC_ALL") or env.get(b"LC_CTYPE") or env.get(b"LANG") or b"C"
    return b"C.UTF-8" if v in (b"C", b"POSIX") else v


def plan(cwd, argv, env, fds):
    for e in env:
        if e.startswith(b"PYTHON"):
            return None, e.partition(b"=")[0]
    keys = dict(e.partition(b"=")[::2] for e in env)
    if ctype(keys) != ctype(os.environb):
        return None, "кодировка ".encode() + ctype(keys)
    if not hasattr(time, "tzset") and keys.get(b"TZ") != os.environb.get(b"TZ"):
        return None, b"TZ"
    mine, yours = pick(os.environb, ENV), pick(keys, ENV)
    for k in sorted({*mine, *yours}):
        if mine.get(k) != yours.get(k):
            return None, k
    for p in FILES:
        if os.path.exists(os.path.join(cwd, p)):
            return None, p
    a = argv[1:]
    opts = set()
    while a and a[0] in (b"-u", b"-B"):
        opts.add(a.pop(0))
    if not a:
        return ((opts, b"", None, []), b"") if os.isatty(fds[0]) else (None, b"")
    if a[0] in (b"-c", b"-m"):
        return ((opts, a[0], a[1], a[2:]), b"") if len(a) > 1 else (None, b"")
    if a[0].startswith(b"-") or a[0].endswith(b".pyc"):
        return None, b""
    try:
        with open(os.path.join(cwd, a[0]), "rb") as f:
            head = f.read(4)
    except OSError:
        return None, b""
    if head == importlib.util.MAGIC_NUMBER or head == b"PK\3\4":
        return None, b""
    return (opts, b"", a[0], a[1:]), b""


def stdio(unbuffered):
    enc, err = sys.stdout.encoding, sys.stdout.errors
    out = []
    for fd, name in ((0, "<stdin>"), (1, "<stdout>"), (2, "<stderr>")):
        write = fd > 0
        buffering = 0 if unbuffered and write else -1
        buf = io.open(fd, "wb" if write else "rb", buffering, closefd=False)
        raw = buf.raw if buffering else buf
        raw.name = name
        t = io.TextIOWrapper(buf, enc, "backslashreplace" if fd == 2 else err, "\n",
                             not unbuffered and (raw.isatty() or fd == 2), unbuffered)
        t.mode = "w" if write else "r"
        out.append(t)
    sys.stdin, sys.stdout, sys.stderr = sys.__stdin__, sys.__stdout__, sys.__stderr__ = out


def child(fds, req, how):
    cwd, mask, argv, env = req
    opts, mode, target, rest = how
    os.setsid()
    for n in range(1, 32):
        if n not in (signal.SIGKILL, signal.SIGSTOP):
            try:
                signal.signal(n, signal.SIG_DFL)
            except (OSError, ValueError):
                pass
    signal.signal(signal.SIGINT, signal.default_int_handler)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
    for i, fd in enumerate(fds):
        os.dup2(fd, i)
    for fd in fds:
        if fd > 2:
            os.close(fd)
    try:
        os.chdir(cwd)
    except OSError:
        pass
    os.umask(mask)
    os.environb.clear()
    for e in env:
        k, _, v = e.partition(b"=")
        if k:
            os.environb[k] = v
    if hasattr(time, "tzset"):
        time.tzset()
    stdio(b"-u" in opts)
    if b"-B" in opts:
        sys.dont_write_bytecode = True
    for hook in HOOKS:
        try:
            hook()
        except Exception:
            sys.excepthook(*sys.exc_info())
    sys.orig_argv = [os.fsdecode(x) for x in argv]
    rest = [os.fsdecode(x) for x in rest]
    target = os.fsdecode(target) if target is not None else ""
    main = types.ModuleType("__main__")
    main.__annotations__ = {}
    main.__builtins__ = builtins
    main.__loader__ = importlib.machinery.BuiltinImporter
    sys.modules["__main__"] = main
    code = 0
    try:
        if mode == b"-c":
            sys.argv = ["-c"] + rest
            sys.path.insert(0, "")
            exec(compile(target, "<string>", "exec", dont_inherit=True), main.__dict__)
        elif target == "":
            sys.argv = [""]
            sys.path.insert(0, "")
            hook = getattr(sys, "__interactivehook__", None)
            if hook:
                try:
                    hook()
                except Exception:
                    sys.excepthook(*sys.exc_info())
            import code as console
            console.InteractiveConsole(main.__dict__, "<stdin>").interact(
                'Python %s on %s\nType "help", "copyright", "credits" or "license" for more information.'
                % (sys.version, sys.platform), "")
        elif mode == b"-m":
            sys.argv = ["-m"] + rest
            sys.path.insert(0, os.getcwd())
            runpy._run_module_as_main(target)
        else:
            sys.argv = [target] + rest
            path = os.path.abspath(target)
            sys.path.insert(0, os.path.dirname(os.path.realpath(path)))
            main.__file__ = path
            main.__cached__ = None
            main.__loader__ = importlib.machinery.SourceFileLoader("__main__", path)
            with open(path, "rb") as f:
                src = f.read()
            exec(compile(src, path, "exec", dont_inherit=True), main.__dict__)
    except SystemExit as e:
        code = e.code
    except BaseException as e:
        e.__traceback__ = e.__traceback__.tb_next
        sys.last_exc = sys.last_value = e
        sys.last_type, sys.last_traceback = type(e), e.__traceback__
        sys.excepthook(type(e), e, e.__traceback__)
        code = 130 if isinstance(e, KeyboardInterrupt) else 1
    finish(code)


def finish(code):
    try:
        threading._shutdown()
        atexit._run_exitfuncs()
    except SystemExit as e:
        code = e.code
    except BaseException:
        pass
    if code is None:
        code = 0
    elif not isinstance(code, int):
        try:
            print(code, file=sys.stderr)
        except BaseException:
            pass
        code = 1
    for f in (sys.stdout, sys.stderr):
        try:
            f.flush()
        except BaseException:
            pass
    os._exit(code & 255)


def main():
    os.makedirs(RUN, exist_ok=True)
    lock = open(RUN + "/lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    if sys.path and sys.path[0] == os.path.dirname(HERE):
        del sys.path[0]
    for m in PRE:
        __import__(m)
    os.chdir("/")
    warm()
    gc.collect()
    gc.freeze()
    gc.enable()
    try:
        os.setpriority(os.PRIO_PROCESS, 0, 0)
    except OSError:
        pass
    base = state()
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    srv.listen(32)
    live = {}
    stale = False
    while True:
        gone = not os.path.exists(CLIENT)
        if (stale or gone) and not live:
            srv.close()
            os.unlink(SOCK)
            if gone:
                return
            lock.close()
            os.execv(sys.executable, [sys.executable, HERE])
        conns = [c for _, c in live.values() if c]
        for x in select.select([srv, *live, *conns], [], [], 60)[0]:
            if isinstance(x, int):
                pid, conn = live.pop(x)
                os.close(x)
                code = os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1])
                if conn:
                    try:
                        conn.sendall(b"X%d\n" % code)
                    except OSError:
                        pass
                    conn.close()
            elif x is not srv:
                if not x.recv(64):
                    for k, (pid, conn) in live.items():
                        if conn is x:
                            try:
                                os.killpg(pid, signal.SIGKILL)
                            except OSError:
                                pass
                            live[k] = (pid, None)
                    x.close()
            else:
                conn = srv.accept()[0]
                fds, req, how, why = [], None, None, b""
                try:
                    fds, req = receive(conn)
                except (OSError, ValueError, IndexError):
                    pass
                if req and not stale and not gone:
                    if state() != base:
                        stale = True
                    else:
                        how, why = plan(req[0], req[2], req[3], fds)
                if stale:
                    why = "перезапуск".encode()
                pid = -1
                if how:
                    try:
                        pid = os.fork()
                    except OSError:
                        why = b"fork"
                if pid == 0:
                    srv.close()
                    lock.close()
                    conn.close()
                    for k, (_, c) in live.items():
                        os.close(k)
                        if c:
                            c.close()
                    child(fds, req, how)
                for fd in fds:
                    os.close(fd)
                try:
                    if pid > 0:
                        live[os.pidfd_open(pid)] = (pid, conn)
                        conn.sendall(b"P%d\n" % pid)
                    else:
                        conn.sendall(b"E" + why.replace(b"\n", b" ")[:100] + b"\n")
                        conn.close()
                except OSError:
                    pass


main()
