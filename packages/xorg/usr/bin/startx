#!/bin/sh
# X на экране: Xorg без OpenGL (KMS /dev/dri/card0), клавиатура и мышь - evdev; сессия -
# ~/.xinitrc, без него twm и xterm. Выход из сессии - обратно в терминал.
# Размер: startx 1024x768; без него - место под экран на странице, точка X на точку экрана, если
# в видеопамять влезают два кадра (так требует драйвер bochs), иначе точка X крупнее - во сколько
# нужно, а больше двух - в целое число раз, чтобы пиксели были ровные
[ -e /tmp/.X0-lock ] && { echo "startx: X уже запущен (/tmp/.X0-lock)" >&2; exit 1; }
area=$(kt screen size) || exit 1
set -- "$1" $area
vram=$5
[ "$vram" -ge 4194304 ] || { kt screen on; exit 1; }  # экрана нет - kt screen скажет почему
if [ -n "$1" ]; then
  size=$1
  case $size in
    *[!0-9x]*|x*|*x|*x*x*) echo "startx: размер как 800x600" >&2; exit 1 ;;
  esac
  [ $((${size%x*} * ${size#*x} * 8)) -le $vram ] || {
    echo "startx: $size не влезает в видеопамять ($((vram >> 20)) МБ, нужно два кадра)" >&2; exit 1; }
else
  size=$(awk -v w="$2" -v h="$3" -v d="$4" -v m="$vram" 'BEGIN {
    W = w * d; H = h * d; s = 1
    while (W / s * H / s * 8 > m) s += 0.25
    if (s > 2) s = int(s + 0.99)
    printf "%dx%d", int(W / s / 8) * 8, int(H / s)
  }')
fi
w=${size%x*} h=${size#*x}
mkdir -p /tmp/.X11-unix /var/lib/xkb /var/log
rm -f /tmp/.X11-unix/X0  # от прошлого сервера: по нему ждём готовности нового

# клавиатура - устройство с клавишей A (бит 30 младшего слова), мышь - с абсолютными
# координатами (мышь VMware)
kbd= ptr=
for e in /sys/class/input/event*; do
  [ -e "$e" ] || continue
  keys=$(cat "$e/device/capabilities/key")
  if [ "$(cat "$e/device/capabilities/abs")" != 0 ]; then
    ptr=${ptr:-/dev/input/${e##*/}}
  elif [ $((0x${keys##* } >> 30 & 1)) = 1 ]; then
    kbd=${kbd:-/dev/input/${e##*/}}
  fi
done

conf=/tmp/xorg.conf
cat > $conf <<EOF
Section "Files"
  FontPath "/usr/share/fonts/misc"
  FontPath "built-ins"
EndSection
Section "ServerFlags"
  Option "AutoAddDevices" "false"
  Option "DontVTSwitch" "true"
  Option "BlankTime" "0"
  Option "StandbyTime" "0"
  Option "SuspendTime" "0"
  Option "OffTime" "0"
EndSection
Section "Monitor"
  Identifier "monitor"
  HorizSync 1-1000
  VertRefresh 1-1000
  # видеокарта виртуальная: годится любой размер, частоты - для порядка
  Modeline "$size" $(((w + 160) * (h + 30) * 60 / 1000000 + 1)) $w $((w + 16)) $((w + 64)) $((w + 160)) $h $((h + 3)) $((h + 6)) $((h + 30))
  Option "PreferredMode" "$size"
EndSection
Section "Device"
  Identifier "card"
  Driver "modesetting"
  Option "kmsdev" "/dev/dri/card0"
  Option "Monitor-Virtual-1" "monitor"
EndSection
Section "Screen"
  Identifier "screen"
  Device "card"
  Monitor "monitor"
  DefaultDepth 24
  SubSection "Display"
    Modes "$size"
  EndSubSection
EndSection
Section "InputDevice"
  Identifier "keyboard"
  Driver "evdev"
  Option "Device" "$kbd"
  Option "XkbLayout" "us,ru"
  Option "XkbOptions" "grp:alt_shift_toggle"
EndSection
Section "InputDevice"
  Identifier "mouse"
  Driver "evdev"
  Option "Device" "$ptr"
EndSection
Section "ServerLayout"
  Identifier "layout"
  Screen "screen"
  InputDevice "keyboard" "CoreKeyboard"
  InputDevice "mouse" "CorePointer"
EndSection
EOF

kt screen on || exit 1
Xorg :0 -config $conf -nolisten tcp -noreset > /dev/null 2>&1 &
xpid=$!
trap 'kill $xpid 2>/dev/null; wait $xpid 2>/dev/null; kt screen off' EXIT
trap 'exit 130' INT TERM HUP
i=0
until [ -S /tmp/.X11-unix/X0 ]; do
  kill -0 $xpid 2>/dev/null || { echo "startx: Xorg не запустился, см. /var/log/Xorg.0.log" >&2; exit 1; }
  i=$((i + 1))
  [ $i -lt 600 ] || { echo "startx: Xorg не ответил за 60 с" >&2; exit 1; }
  usleep 100000
done
export DISPLAY=:0
if [ -f "$HOME/.xinitrc" ]; then
  sh "$HOME/.xinitrc"
else
  if [ -f "$HOME/.twmrc" ]; then twm & else twm -f /etc/X11/twmrc & fi
  xterm -geometry 80x24+20+20
fi
