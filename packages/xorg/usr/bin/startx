#!/bin/sh
# X на экране: Xorg без OpenGL (KMS, карта с разъёмом), клавиатура и мышь - evdev; сессия -
# ~/.xinitrc, без него twm и xterm. Выход из сессии - обратно в терминал.
# Размер: startx 1024x768 - свой, постоянный; без него - тот, что даёт страница (kt screen size: место
# под экран, видеопамять, kt cfg screen.scale), и он идёт за страницей: окно браузера поменяло размер
# или телефон повернули - страница шлёт событие screen-size, и режим меняет xrandr
[ -e /tmp/.X0-lock ] && { echo "startx: X уже запущен (/tmp/.X0-lock)" >&2; exit 1; }
follow=
if [ -n "$1" ]; then
  size=$1
else
  size=$(kt screen size) || exit 1
  follow=1
fi
case $size in
  *[!0-9x]*|x*|*x|*x*x*) echo "startx: размер как 800x600" >&2; exit 1 ;;
esac
w=${size%x*} h=${size#*x}
# видеокарта виртуальная: годится любой размер, частоты - для порядка
modeline() { echo "$((($1 + 160) * ($2 + 30) * 60 / 1000000 + 1)) $1 $(($1 + 16)) $(($1 + 64)) $(($1 + 160)) $2 $(($2 + 3)) $(($2 + 6)) $(($2 + 30))"; }
mkdir -p /tmp/.X11-unix /var/lib/xkb /var/log
rm -f /tmp/.X11-unix/X0  # от прошлого сервера: по нему ждём готовности нового

# клавиатура - устройство с клавишей A (бит 30 младшего слова), мышь - с абсолютными
# координатами (мышь VMware)
kbd= ptr=
for e in /sys/class/input/event*; do
  [ -e "$e" ] || continue
  keys=$(cat "$e/device/capabilities/key")
  if [ "$(cat "$e/device/capabilities/abs")" != 0 ]; then
    ptr=${ptr:-/dev/input/${e##*/}}
  elif [ $((0x${keys##* } >> 30 & 1)) = 1 ]; then
    kbd=${kbd:-/dev/input/${e##*/}}
  fi
done

# экран - карта DRM с разъёмом (cardN-Virtual-1): у virtio-gpu без своего экрана (только 3D) их
# нет, а номер у неё может быть меньше, чем у VGA
card=
for c in /sys/class/drm/card*-*; do
  [ -e "$c" ] || continue
  c=${c##*/}
  card=/dev/dri/${c%%-*}
  break
done
[ -n "$card" ] || { echo "startx: нет экрана (карты KMS в /sys/class/drm)" >&2; exit 1; }

conf=/tmp/xorg.conf
cat > $conf <<EOF
Section "Files"
  FontPath "/usr/share/fonts/misc"
  FontPath "built-ins"
EndSection
Section "ServerFlags"
  Option "AutoAddDevices" "false"
  Option "DontVTSwitch" "true"
  Option "BlankTime" "0"
  Option "StandbyTime" "0"
  Option "SuspendTime" "0"
  Option "OffTime" "0"
EndSection
Section "Monitor"
  Identifier "monitor"
  HorizSync 1-1000
  VertRefresh 1-1000
  # видеокарта виртуальная: годится любой размер, частоты - для порядка
  Modeline "$size" $(modeline $w $h)
  Option "PreferredMode" "$size"
EndSection
Section "Device"
  Identifier "card"
  Driver "modesetting"
  Option "kmsdev" "$card"
  Option "Monitor-Virtual-1" "monitor"
EndSection
Section "Screen"
  Identifier "screen"
  Device "card"
  Monitor "monitor"
  DefaultDepth 24
  SubSection "Display"
    Modes "$size"
  EndSubSection
EndSection
Section "InputDevice"
  Identifier "keyboard"
  Driver "evdev"
  Option "Device" "$kbd"
  Option "XkbLayout" "us,ru"
  # раскладка - CapsLock (Shift+CapsLock - сам CapsLock): Alt+Shift нужен оконным менеджерам (dwm)
  Option "XkbOptions" "grp:caps_toggle"
EndSection
Section "InputDevice"
  Identifier "mouse"
  Driver "evdev"
  Option "Device" "$ptr"
EndSection
Section "ServerLayout"
  Identifier "layout"
  Screen "screen"
  InputDevice "keyboard" "CoreKeyboard"
  InputDevice "mouse" "CorePointer"
EndSection
EOF

kt screen on || exit 1
Xorg :0 -config $conf -nolisten tcp -noreset > /dev/null 2>&1 &
xpid=$!
rpid=
trap 'kill $xpid 2>/dev/null; wait $xpid 2>/dev/null; [ -z "$rpid" ] || { pkill -P $rpid; kill $rpid; } 2>/dev/null; kt screen off' EXIT
trap 'exit 130' INT TERM HUP
i=0
until [ -S /tmp/.X11-unix/X0 ]; do
  kill -0 $xpid 2>/dev/null || { echo "startx: Xorg не запустился, см. /var/log/Xorg.0.log" >&2; exit 1; }
  i=$((i + 1))
  [ $i -lt 600 ] || { echo "startx: Xorg не ответил за 60 с" >&2; exit 1; }
  usleep 100000
done
export DISPLAY=:0
# размер за страницей: событие screen-size (агент пишет события в /run/kt/events, пока есть
# слушатель - отметка /run/kt/ev.<pid>) -> новый режим через xrandr
if [ -n "$follow" ]; then
  (
    read -r me _ < /proc/self/stat
    : > /run/kt/ev.$me
    : >> /run/kt/events
    tail -n 0 -f /run/kt/events | while IFS= read -r line; do
      case $line in *'"name":"screen-size"'*) ;; *) continue ;; esac
      s=${line#*\"data\":\"}
      s=${s%%\"*}
      xrandr --newmode "$s" $(modeline ${s%x*} ${s#*x}) 2>/dev/null
      xrandr --addmode Virtual-1 "$s" 2>/dev/null
      xrandr --output Virtual-1 --mode "$s"
    done
  ) &
  rpid=$!
fi
if [ -f "$HOME/.xinitrc" ]; then
  sh "$HOME/.xinitrc"
else
  if [ -f "$HOME/.twmrc" ]; then twm & else twm -f /etc/X11/twmrc & fi
  # xterm - на ширину экрана, не больше 80x24 (шрифт 6x13)
  cols=$(((w - 40) / 6)) rows=$(((h - 60) / 13))
  [ $cols -le 80 ] || cols=80
  [ $rows -le 24 ] || rows=24
  xterm -geometry ${cols}x${rows}+10+20
fi
