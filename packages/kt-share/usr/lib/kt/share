#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без имени  эта машина новой ревизией: у получателя заменит прежнюю копию, его своя - в kt snap
имя        новая машина под этим именем: у получателя отдельно от прежних
файл - та же страница с машиной как сейчас; на странице то же делает кнопка справа вверху'
kt_meta "[имя]" "копия машины файлом: отправить другому" "$@"
case $1 in -*) kt_usage "[имя]" ;; esac
rm -f $KT_RUN/share.wait $KT_RUN/share.done
echo "снимаю машину и собираю файл..."
kt js -f /usr/lib/kt-share.js share "$1" > /dev/null || exit 1
# ждать здесь, а не в kt js: снимок с открытым запросом к странице у получателя завис бы.
# У него это ожидание закончит /etc/kt/page.d/kt-share
: > $KT_RUN/share.wait
while [ ! -f $KT_RUN/share.done ]; do usleep 200000; done
r=$(cat $KT_RUN/share.done)
rm -f $KT_RUN/share.wait $KT_RUN/share.done
case $r in
  0*) echo "${r#0}" ;;
  *) echo "${r#1}" >&2; exit 1 ;;
esac
