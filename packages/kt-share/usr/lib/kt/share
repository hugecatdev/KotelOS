#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  новая версия той же машины: у получателя заменит прежнюю, а его правки уйдут в снимок (kt snap)
<name>  другая машина с этим именем: у получателя ляжет отдельно от прежних
получается html-файл в загрузках браузера - эта страница с машиной, как она есть сейчас;
то же делает значок у правого края внизу'
kt_meta "[<name>]" "машина файлом: отправить другому" "$@"
[ $# -le 1 ] || kt_usage "[<name>]"
[ -z "$1" ] || kt_name "$1" 24
rm -f $KT_RUN/share.wait $KT_RUN/share.done
echo "снимаю машину и собираю файл..." >&2
kt_js "$(cat /usr/lib/kt-share.js)" share "$1" > /dev/null || exit 1
# ждать здесь, а не в запросе к странице: снимок с открытым запросом у получателя завис бы.
# У него это ожидание закончит /etc/kt/page.d/kt-share
: > $KT_RUN/share.wait
while [ ! -f $KT_RUN/share.done ]; do usleep 200000; done
r=$(cat $KT_RUN/share.done)
rm -f $KT_RUN/share.wait $KT_RUN/share.done
case $r in
  0*) echo "${r#0}" ;;
  *) kt_die "${r#1}" ;;
esac
