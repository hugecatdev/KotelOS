#!/bin/sh
. /usr/lib/kt.sh
KT_HELP='без аргументов  синхронизируемые каталоги: каталог <- папка на диске
add [<dir>]  выбрать папку на диске и скопировать в dir (по умолчанию /mnt/<имя папки>), правки пишутся обратно
rm <dir>  перестать писать dir на диск, файлы в машине остаются
только Chrome и Edge'
kt_meta "[add [<dir>] | rm <dir>]" "папка с диска, правки пишутся обратно" "$@"
REG=$KT_RUN/sync
mkdir -p $REG

stop() {
  for f in $REG/*; do
    [ -f "$f" ] && [ "$(head -n 1 "$f")" = "$1" ] || continue
    kill "${f##*/}" 2>/dev/null
    rm -f "$f"
    echo 1
  done
}

case "$1" in
  "")
    for f in $REG/*; do
      [ -f "$f" ] && kill -0 "${f##*/}" 2>/dev/null && printf '%s <- %s\n' "$(head -n 1 "$f")" "$(tail -n 1 "$f")"
    done
    exit 0 ;;
  rm)
    [ $# -eq 2 ] || kt_usage "rm <dir>"
    d=$(realpath "$2" 2>/dev/null || echo "$2")
    [ -n "$(stop "$d")" ] || kt_die "$d не синхронизируется"
    kt_js "async (r) => { $(cat /usr/lib/kt-sync.js)
      await del(r) }" "$d" > /dev/null 2>&1
    echo "- $d, файлы остались в машине"
    exit 0 ;;
  add) [ $# -le 2 ] || kt_usage "add [<dir>]" ;;
  *) kt_usage "[add [<dir>] | rm <dir>]" ;;
esac

dir=
case "$2" in
  "") ;;
  /*) dir=$2 ;;
  *) dir=$PWD/$2 ;;
esac
T=$KT_RUN/sync.$$.tar
trap 'rm -f "$T"' EXIT
r=$(kt_js "async (to, p) => { $(cat /usr/lib/kt-sync.js)
  return pick(to, p) }" "$dir" "$T") || exit 1
IFS="$(printf '\t')" read -r dir name files size <<EOF2
$r
EOF2
stop "$dir" > /dev/null
mkdir -p "$dir"
tar -xf "$T" -C "$dir" || exit 1
setsid /usr/sbin/kt-syncd "$dir" "$name" > /dev/null 2>&1 < /dev/null &
echo "$(kt_files "$files"), $(kt_size "$size")"
echo "$dir <- $name"
