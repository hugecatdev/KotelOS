@@ -0,0 +1,42 @@
+//! FxHash (как rustc-hash 2): ключи JIT - страницы, адреса, индексы, метки - небольшие целые, а
+//! SipHash стандартного HashMap защищает от подобранных ключей, которых здесь нет. Учёт нагрева
+//! страниц идёт на каждый запуск интерпретатора: с SipHash это было ~5% времени Designer.
+
+use std::hash::{BuildHasherDefault, Hasher};
+
+const K: u64 = 0xf1357aea2e62a9c5;
+
+#[derive(Default, Clone, Copy)]
+pub struct FxHasher {
+    hash: u64,
+}
+
+impl FxHasher {
+    #[inline]
+    fn add(&mut self, word: u64) { self.hash = self.hash.wrapping_add(word).wrapping_mul(K); }
+}
+
+impl Hasher for FxHasher {
+    #[inline]
+    fn write(&mut self, bytes: &[u8]) {
+        for &b in bytes {
+            self.add(b as u64)
+        }
+    }
+    #[inline]
+    fn write_u8(&mut self, i: u8) { self.add(i as u64) }
+    #[inline]
+    fn write_u16(&mut self, i: u16) { self.add(i as u64) }
+    #[inline]
+    fn write_u32(&mut self, i: u32) { self.add(i as u64) }
+    #[inline]
+    fn write_u64(&mut self, i: u64) { self.add(i) }
+    #[inline]
+    fn write_usize(&mut self, i: usize) { self.add(i as u64) }
+    // старшие биты произведения перемешаны лучше младших: hashbrown берёт индекс из младших
+    #[inline]
+    fn finish(&self) -> u64 { self.hash.rotate_left(26) }
+}
+
+pub type HashMap<K, V> = std::collections::HashMap<K, V, BuildHasherDefault<FxHasher>>;
+pub type HashSet<K> = std::collections::HashSet<K, BuildHasherDefault<FxHasher>>;
