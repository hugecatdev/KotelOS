+// A page that a memory access of the current basic block has found valid on its fast path, kept
+// for the following accesses based on the same register (most are relative to esp, ebp or one
+// pointer): such an access only checks that it lies inside that page and uses the translation
+// directly - a subtraction and a comparison instead of the walk through the tlb.
+//
+// The translation stays valid while the tlb does, and only calls of the emulator change it. The
+// slow path of an access poisons all the slots at run time (page is set to a value no address is
+// near); any other call drops them at compile time (WasmBuilder::call_count). A slot is created
+// and used only at the nesting depth of the basic block itself, so its creation dominates its
+// uses, and is dropped at the end of the block. A page checked for reading is not used for
+// writing
+pub struct MemSlot {
+    // address of the page, zero extended; MEM_SLOT_POISON if not valid
+    page: WasmLocalI64,
+    // tlb entry of the page without the flags: host address = address ^ host
+    host: WasmLocal,
+    write: bool,
+    // The code that has filled the slot and that no access has used yet (ranges of the function
+    // body): if none does, it is replaced with nops when the slot is dropped, so only accesses
+    // that are followed by another one pay for the slot
+    unused: Vec<(u32, u32)>,
+}
+const MEM_SLOT_POISON: i64 = 1 << 40;
+
+pub fn gen_mem_slots_begin(ctx: &mut JitContext) {
+    gen_mem_slots_end(ctx);
+    ctx.mem_base = None;
+    ctx.mem_calls = ctx.builder.call_count();
+    ctx.mem_depth = ctx.builder.label_depth();
+}
+pub fn gen_mem_slots_end(ctx: &mut JitContext) {
+    for i in 0..ctx.mem_slots.len() {
+        if let Some(slot) = ctx.mem_slots[i].take() {
+            for (from, to) in slot.unused {
+                ctx.builder.replace_with_nops(from, to);
+            }
+            ctx.builder.free_local_i64(slot.page);
+            ctx.builder.free_local(slot.host);
+        }
+    }
+}
+
+struct MemAccess {
+    // the slot (base register) this access fills
+    slot: Option<usize>,
+    // the access first tries the slot: local for the host address, set on both paths
+    reuse: Option<WasmLocal>,
+}
+
+/// Before the tlb lookup of an access: try the slot of the base register
+fn gen_mem_access_begin(
+    ctx: &mut JitContext,
+    address_local: &WasmLocal,
+    bytes: u32,
+    is_write: bool,
+) -> MemAccess {
+    let base = ctx.mem_base.take();
+    if ctx.builder.call_count() != ctx.mem_calls {
+        // a call since the last access: the tlb may be different
+        gen_mem_slots_end(ctx);
+        ctx.mem_calls = ctx.builder.call_count();
+    }
+    let slot = match base {
+        Some(r)
+            if unsafe { crate::jit::JIT_MEM_REUSE }
+                && ctx.builder.label_depth() == ctx.mem_depth =>
+        {
+            Some(r as usize)
+        },
+        _ => None,
+    };
+    let mut reuse = None;
+    if let Some(s) = slot.and_then(|i| ctx.mem_slots[i].as_mut()) {
+        if s.write || !is_write {
+            // what has filled the slot is used now
+            s.unused.clear();
+            // outer block: closed in gen_mem_access_end; inner block: the lookup follows
+            ctx.builder.block_void();
+            let lookup = ctx.builder.block_void();
+            ctx.builder.get_local(address_local);
+            ctx.builder.extend_unsigned_i32_to_i64();
+            ctx.builder.get_local_i64(&s.page);
+            ctx.builder.sub_i64();
+            ctx.builder.const_i64(0x1000 - bytes as i64);
+            ctx.builder.gtu_i64();
+            ctx.builder.br_if_hint(lookup, false);
+            ctx.builder.get_local(address_local);
+            ctx.builder.get_local(&s.host);
+            ctx.builder.xor_i32();
+            let host_address = ctx.builder.set_new_local();
+            // out of the outer block
+            ctx.builder.br_outer(1);
+            ctx.builder.block_end();
+            reuse = Some(host_address);
+        }
+    }
+    MemAccess { slot, reuse }
+}
+
+/// Right before the branch to the fast path (the condition is on the stack): the slot gets the
+/// page of this access - if the slow path is taken, it is poisoned there
+fn gen_mem_access_fill(
+    ctx: &mut JitContext,
+    access: &MemAccess,
+    address_local: &WasmLocal,
+    is_write: bool,
+) {
+    let i = match access.slot {
+        Some(i) => i,
+        None => return,
+    };
+    let from = ctx.builder.instruction_body_length();
+    ctx.builder.get_local(address_local);
+    ctx.builder.const_i32(!0xFFF);
+    ctx.builder.and_i32();
+    ctx.builder.extend_unsigned_i32_to_i64();
+    match &mut ctx.mem_slots[i] {
+        Some(slot) => {
+            ctx.builder.set_local_i64(&slot.page);
+            slot.write = is_write;
+            slot.unused
+                .push((from, ctx.builder.instruction_body_length()));
+        },
+        None => {
+            let page = ctx.builder.set_new_local_i64();
+            ctx.builder.const_i32(0);
+            let host = ctx.builder.set_new_local();
+            ctx.mem_slots[i] = Some(MemSlot {
+                page,
+                host,
+                write: is_write,
+                unused: vec![(from, ctx.builder.instruction_body_length())],
+            });
+        },
+    }
+}
+
+/// On the slow path, after its call: the tlb may have changed, and what the call returned is
+/// only good for this access
+fn gen_mem_access_slow(ctx: &mut JitContext) {
+    for i in 0..ctx.mem_slots.len() {
+        if let Some(slot) = &ctx.mem_slots[i] {
+            ctx.builder.const_i64(MEM_SLOT_POISON);
+            ctx.builder.set_local_i64(&slot.page);
+        }
+    }
+    ctx.mem_calls = ctx.builder.call_count();
+}
+
+/// After the lookup: leaves the host address on the stack
+fn gen_mem_access_end(
+    ctx: &mut JitContext,
+    access: MemAccess,
+    entry_local: &WasmLocal,
+    address_local: &WasmLocal,
+) {
+    ctx.builder.get_local(entry_local);
+    ctx.builder.const_i32(!0xFFF);
+    ctx.builder.and_i32();
+    if let Some(slot) = access.slot.and_then(|i| ctx.mem_slots[i].as_mut()) {
+        let from = ctx.builder.instruction_body_length();
+        ctx.builder.tee_local(&slot.host);
+        slot.unused
+            .push((from, ctx.builder.instruction_body_length()));
+    }
+    ctx.builder.get_local(address_local);
+    ctx.builder.xor_i32();
+    if let Some(host_address) = access.reuse {
+        ctx.builder.set_local(&host_address);
+        ctx.builder.block_end();
+        ctx.builder.get_local(&host_address);
+        ctx.builder.free_local(host_address);
+    }
+}
