+/// Instructions starting in the last MAX_INSTRUCTION_LENGTH bytes of a page used to be left to the
+/// interpreter, as they may continue on the next page. Compile such an instruction if it ends
+/// within its page (possibly exactly at the end). The decoder reads the bytes of an instruction in
+/// order, so it only reads past the end of the page (another physical page, irrelevant here) when
+/// the instruction doesn't fit. 16-bit code keeps the old rule (instruction pointer wrap-around).
+#[inline]
+pub fn fits_in_page(phys_address: u32, cpu: &CpuContext) -> bool {
+    !is_near_end_of_page(phys_address)
+        || fits_in_page_near_end(phys_address, cpu.cs_offset, cpu.state_flags)
+}
+
+// Out of line and cold: jit_increase_hotness runs after every interpreted block, the decoder
+// must not end up in it (it changed inlining in the main loop and slowed down transitions).
+#[cold]
+#[inline(never)]
+fn fits_in_page_near_end(phys_address: u32, cs_offset: u32, state_flags: CachedStateFlags) -> bool {
+    if !state_flags.is_32() {
+        return false;
+    }
+    let page_end = (phys_address | 0xFFF) + 1;
+    if page_end + MAX_INSTRUCTION_LENGTH > unsafe { *crate::cpu::global_pointers::memory_size } {
+        return false;
+    }
+    let mut probe = CpuContext {
+        eip: phys_address,
+        prefixes: 0,
+        cs_offset,
+        state_flags,
+    };
+    analysis::analyze_step(&mut probe);
+    probe.eip <= page_end
+}
