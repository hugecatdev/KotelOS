+/**
+ * Contents of the files in a directory of the Origin Private File System, one OPFS file per key.
+ * A key is written once: a new version of a guest file gets a new key, so a saved state reads
+ * exactly what it wrote. Only the File objects of open files stay in memory, not the data.
+ *
+ * @constructor
+ * @implements {FileStorageInterface}
+ * @param {string} name directory in the root of the OPFS
+ */
+export function OpfsFileStorage(name)
+{
+    const storage = /** @type {?} */ (navigator).storage;
+    /**
+     * no OPFS (a page from a file): writes fail, and the FS keeps the contents in memory
+     * @type {!Promise<?>}
+     */
+    this.dir = storage && storage.getDirectory ?
+        storage.getDirectory().then(root => root.getDirectoryHandle(name, { create: true })) :
+        Promise.reject(new Error("no OPFS"));
+    this.dir.catch(() => {});
+    /** @type {!Map<string, !Promise<?>>} */
+    this.files = new Map();
+}
+
+/**
+ * @return {string}
+ */
+OpfsFileStorage.prototype.new_key = function()
+{
+    return Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 12);
+};
+
+/**
+ * @param {string} key
+ * @param {number} offset
+ * @param {number} count
+ * @return {!Promise<Uint8Array>} null if file does not exist.
+ */
+OpfsFileStorage.prototype.read = async function(key, offset, count)
+{
+    let file = this.files.get(key);
+    if(!file)
+    {
+        file = this.dir.then(dir => dir.getFileHandle(key)).then(handle => handle.getFile());
+        this.files.set(key, file);
+    }
+    try
+    {
+        const blob = (await file).slice(offset, offset + count);
+        return new Uint8Array(await blob.arrayBuffer());
+    }
+    catch(e)
+    {
+        this.files.delete(key);
+        return null;
+    }
+};
+
+/**
+ * @param {string} key
+ * @param {!Uint8Array} data
+ * @return {!Promise}
+ */
+OpfsFileStorage.prototype.write = async function(key, data)
+{
+    const dir = await this.dir;
+    const handle = await dir.getFileHandle(key, { create: true });
+    if(handle.createWritable)
+    {
+        const stream = await handle.createWritable();
+        await stream.write(data);
+        await stream.close();
+    }
+    else
+    {
+        // Safari: only the synchronous handle of a worker
+        const sync = await handle.createSyncAccessHandle();
+        sync.truncate(0);
+        sync.write(data, { at: 0 });
+        sync.flush();
+        sync.close();
+    }
+};
+
+/**
+ * @param {string} key
+ * @param {!Uint8Array} data
+ */
+OpfsFileStorage.prototype.cache = async function(key, data)
+{
+    await this.write(key, data);
+};
+
+/**
+ * @param {string} key
+ */
+OpfsFileStorage.prototype.uncache = function(key)
+{
+    this.files.delete(key);
+};
+
+/**
+ * @return {!Promise<!Array<string>>} all keys
+ */
+OpfsFileStorage.prototype.list = async function()
+{
+    const dir = await this.dir;
+    const keys = [];
+    for await (const name of dir.keys()) keys.push(name);
+    return keys;
+};
+
+/**
+ * @param {string} key
+ * @return {!Promise}
+ */
+OpfsFileStorage.prototype.remove = async function(key)
+{
+    this.files.delete(key);
+    const dir = await this.dir;
+    await dir.removeEntry(key).catch(() => {});
+};
