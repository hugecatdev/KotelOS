+/**
+ * Contents of a written file go to a storage that can write (OpfsFileStorage): memory keeps the
+ * inode only. A storage key is written once, the file gets a new one.
+ * @param {number} id
+ */
+FS.prototype.flush = async function(id)
+{
+    const inode = this.inodes[id];
+    const data = this.inodedata[id];
+    if(!data || !inode || inode.status !== STATUS_OK) return;
+    const change = this.changes.get(id);
+    const key = this.storage.new_key();
+    try
+    {
+        await this.storage.write(key, data.subarray(0, inode.size));
+    }
+    catch(e)
+    {
+        dbg_log("Filesystem: flush to storage failed: " + e, LOG_9P);
+        return;
+    }
+    if(this.inodedata[id] !== data || this.changes.get(id) !== change || inode.status !== STATUS_OK)
+    {
+        // written, truncated or deleted meanwhile: the next close tries again
+        this.storage.remove(key);
+        return;
+    }
+    delete this.inodedata[id];
+    inode.status = STATUS_ON_STORAGE;
+    inode.sha256sum = key;
