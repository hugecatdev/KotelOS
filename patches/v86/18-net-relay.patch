+/**
+ * кадр машины - поддельному стеку: ARP и IPv4 к адресу страницы, DHCP без класса "kt-wan"
+ * @param {Uint8Array} data
+ * @return {boolean}
+ */
+NetworkAdapter.prototype.is_local = function(data)
+{
+    const r = this.router_ip;
+    const type = data.length >= 14 ? data[12] << 8 | data[13] : 0;
+    if(type === 0x0806)
+    {
+        return data.length >= 42 && data[38] === r[0] && data[39] === r[1] && data[40] === r[2] && data[41] === r[3];
+    }
+    if(type !== 0x0800 || data.length < 34)
+    {
+        return false;
+    }
+    if(data[30] === r[0] && data[31] === r[1] && data[32] === r[2] && data[33] === r[3])
+    {
+        return true;
+    }
+    const udp = 14 + (data[14] & 15) * 4;
+    if(data[23] !== 17 || data.length < udp + 8 || (data[udp + 2] << 8 | data[udp + 3]) !== 67)
+    {
+        return false;
+    }
+    // опции DHCP: после заголовка BOOTP (236) и magic cookie (4)
+    for(let o = udp + 8 + 240; o + 1 < data.length && data[o] !== 255; o += data[o] ? data[o + 1] + 2 : 1)
+    {
+        if(data[o] === 60)
+        {
+            return String.fromCharCode.apply(null, data.subarray(o + 2, o + 2 + data[o + 1])) !== "kt-wan";
+        }
+    }
+    return true;
+};
