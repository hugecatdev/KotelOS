 /**
+ * Сеть на ходу: прежний адаптер закрывается и снимается с шины, новый получает MAC карты и открытые
+ * соединения со страницей. relay_url - "fetch", "inbrowser", wisp(s)://сервер, ws(s)://релей Ethernet;
+ * пусто - без адаптера. Карта и машина не меняются; адрес в сети релея Ethernet машина берёт сама
+ * (DHCP с классом "kt-wan", см. network.js).
+ * @param {?} relay_url строка, как options.net_device.relay_url (у адаптера Wisp тип - String)
+ */
+V86.prototype.set_relay = function(relay_url)
+{
+    const old = this.network_adapter;
+    if(old)
+    {
+        old.destroy();
+        for(const name of Object.keys(this.bus.listeners))
+        {
+            this.bus.listeners[name] = this.bus.listeners[name].filter(l => l.this_value !== old);
+        }
+    }
+    this.network_adapter = undefined;
+    if(!relay_url)
+    {
+        return;
+    }
+    const net_device = this.net_device_options;
+    // TODO: remove bus, use direct calls instead
+    if(relay_url === "fetch")
+    {
+        this.network_adapter = new FetchNetworkAdapter(this.bus, net_device);
+    }
+    else if(relay_url === "inbrowser")
+    {
+        // NOTE: experimental, will change when usage of options.net_device gets refactored in favour of emulator.bus
+        this.network_adapter = new InBrowserNetworkAdapter(this.bus, net_device);
+    }
+    else if(relay_url.startsWith("wisp://") || relay_url.startsWith("wisps://"))
+    {
+        this.network_adapter = new WispNetworkAdapter(relay_url, this.bus, net_device);
+    }
+    else
+    {
+        this.network_adapter = new NetworkAdapter(relay_url, this.bus, net_device);
+    }
+    const adapter = this.network_adapter;
+    // открытые соединения поддельного стека (агент kt, консоли) - новому адаптеру: адрес машины для
+    // связи со страницей у всех один. Потоки Wisp уходят вместе с его сервером
+    if(old && old.tcp_conn && adapter.tcp_conn)
+    {
+        for(const tuple of Object.keys(old.tcp_conn))
+        {
+            const conn = old.tcp_conn[tuple];
+            if(conn.stream_id !== undefined) continue;
+            conn.net = adapter;
+            adapter.tcp_conn[tuple] = conn;
+        }
+    }
+    if(this.net0_mac)
+    {
+        for(const l of this.bus.listeners["net0-mac"] || [])
+        {
+            if(l.this_value === adapter) l.fn.call(adapter, this.net0_mac);
+        }
+    }
+};
+
+/**
  * Free resources associated with this instance
  */
 V86.prototype.destroy = async function()
