diff --git a/src/rust/cpu/cpu.rs b/src/rust/cpu/cpu.rs
index 5435dc0..26fd99e 100644
--- a/src/rust/cpu/cpu.rs
+++ b/src/rust/cpu/cpu.rs
@@ -265,6 +265,36 @@ pub const TLB_IN_MAPPED_RANGE: i32 = 1 << 3;
 pub const TLB_GLOBAL: i32 = 1 << 4;
 pub const TLB_HAS_CODE: i32 = 1 << 5;
 pub const TLB_NO_EXEC: i32 = 1 << 6;
+// страница видеопамяти (LFB): запись ведёт прямо в vga_mem8, обращения идут быстрым путём JIT.
+// Изменённые страницы отмечаются, когда запись становится доступной для записи (do_page_walk);
+// экран забрал отметки - такие записи снова только для чтения (svga_tlb_protect)
+pub const TLB_SVGA: i32 = 1 << 7;
+static mut svga_tlb_writable: bool = false;
+
+#[inline(always)]
+pub unsafe fn tlb_entry_phys(entry: i32, address: i32) -> u32 {
+    let host = (entry & !0xFFF ^ address) as u32;
+    if entry & TLB_SVGA != 0 {
+        host - memory::vga_mem8 as u32 + memory::VGA_LFB_ADDRESS
+    }
+    else {
+        host - memory::mem8 as u32
+    }
+}
+
+pub unsafe fn svga_tlb_protect() {
+    if !svga_tlb_writable {
+        return;
+    }
+    svga_tlb_writable = false;
+    for i in 0..valid_tlb_entries_count {
+        let page = valid_tlb_entries[i as usize];
+        let entry = tlb_data[page as usize];
+        if entry & TLB_SVGA != 0 {
+            tlb_data[page as usize] = entry | TLB_READONLY;
+        }
+    }
+}
 pub const IVT_SIZE: u32 = 0x400;
 pub const CPU_EXCEPTION_DE: i32 = 0;
 pub const CPU_EXCEPTION_DB: i32 = 1;
