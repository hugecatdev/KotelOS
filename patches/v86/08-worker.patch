+/*
+ * Web Worker mode (options.worker = { source, wasm }): the CPU and the devices run in a worker
+ * created from the source of this library, the adapters (network, serial, keyboard, mouse) stay
+ * on the page. Both ends of the bus are bridged with postMessage: messages are batched and sent
+ * once per microtask, so per-byte events (serial0-output-byte) don't become one message each.
+ * The screen: the ScreenAdapter stays on the page, the VGA in the worker draws through a
+ * WorkerScreenAdapter, which sends the calls over and the changed rectangles of a frame as
+ * copies; a frame is asked for once per animation frame of the page, one at a time. Errors in
+ * the worker come as the bus event "worker-error" (and in the console of the page).
+ */
+
+// Messages of the worker bridge that are not bus events
+const WORKER_SCREEN = "\u0000screen";
+const WORKER_FRAME = "\u0000frame";
+const WORKER_FILLED = "\u0000filled";
+
+/**
+ * Messages are sent in batches, later: a view on memory that gets reused (a packet in the buffer
+ * of the network card) must be copied when it is queued
+ *
+ * @param {*} value
+ * @return {*}
+ */
+function copy_view(value)
+{
+    return value instanceof Uint8Array ? value.slice() : value;
+}
+
+/**
+ * @param {Object} options
+ */
+V86.prototype.worker_init = function(options)
+{
+    const blob = new Blob([options.worker.source, "\n;self['V86']['worker_main']();\n"], { type: "text/javascript" });
+    const url = URL.createObjectURL(blob);
+    this.worker = new Worker(url);
+    URL.revokeObjectURL(url);
+
+    this.worker_calls = new Map();
+    this.worker_fill_pending = false;
+    // buffers of drawn frames, go back to the worker with the next request: no new allocations
+    // per frame (they made the garbage collector of the page stop it for 10-30 ms now and then)
+    this.worker_frames_back = [];
+    // compressed files that the worker unpacks (it has the wasm with zstd): name -> size
+    this.worker_zst = {};
+    this.worker_call_id = 0;
+    this.worker_queue = [];
+
+    // adapters -> devices
+    /**
+     * @param {string} name
+     * @param {*=} value
+     */
+    this.bus.send = (name, value) => {
+        if(this.worker_queue.push([name, copy_view(value)]) === 1)
+        {
+            queueMicrotask(() => this.worker_flush());
+        }
+    };
+
+    this.worker.onmessage = e => {
+        const data = e.data;
+        if(data.t === "bus")
+        {
+            // devices -> adapters (and the page)
+            for(const [name, value] of data.m)
+            {
+                if(name === WORKER_SCREEN)
+                {
+                    const fn = this.screen_adapter[value[0]];
+                    if(fn) fn.apply(this.screen_adapter, value[1]);
+                }
+                else if(name === WORKER_FRAME)
+                {
+                    const [x, y, w, h, pixels] = value;
+                    this.screen_adapter.update_buffer([{
+                        image_data: new ImageData(pixels, w, h),
+                        screen_x: x, screen_y: y,
+                        buffer_x: 0, buffer_y: 0,
+                        buffer_width: w, buffer_height: h,
+                    }]);
+                    this.worker_frames_back.push(pixels.buffer);
+                }
+                else if(name === WORKER_FILLED)
+                {
+                    this.worker_fill_pending = false;
+                }
+                else
+                {
+                    this.emulator_bus.send(name, value);
+                }
+            }
+        }
+        else if(data.t === "result")
+        {
+            const call = this.worker_calls.get(data.id);
+            this.worker_calls.delete(data.id);
+            if(data.error) call.reject(new Error(data.error));
+            else call.resolve(data.result);
+        }
+        else if(data.t === "error")
+        {
+            console.error("v86 worker:", data.error);
+            this.emulator_bus.send("worker-error", data.error);
+        }
+    };
+    // the script of the worker itself failed (syntax, blocked)
+    this.worker.onerror = e => {
+        console.error("v86 worker:", e.message);
+        this.emulator_bus.send("worker-error", e.message || "worker failed");
+    };
+
+    this.continue_init(null, options);
+};
+
+/**
+ * A frame for the screen adapter: one at a time, the next one when this one arrived
+ */
+V86.prototype.worker_fill = function()
+{
+    if(this.worker && !this.worker_fill_pending)
+    {
+        this.worker_fill_pending = true;
+        this.worker_flush();
+        const back = this.worker_frames_back;
+        this.worker_frames_back = [];
+        this.worker.postMessage({ t: "fill", back }, back);
+    }
+};
+
+V86.prototype.worker_flush = function()
+{
+    if(this.worker && this.worker_queue.length)
+    {
+        this.worker.postMessage({ t: "bus", m: this.worker_queue });
+        this.worker_queue = [];
+    }
+};
+
+/**
+ * @param {string} method
+ * @param {*=} arg
+ * @param {Array=} transfer
+ * @return {Promise<*>}
+ */
+V86.prototype.worker_call = function(method, arg, transfer)
+{
+    return new Promise((resolve, reject) => {
+        const id = ++this.worker_call_id;
+        this.worker_calls.set(id, { resolve, reject });
+        // after the bus messages sent before, in the same order
+        this.worker_flush();
+        this.worker.postMessage({ t: "call", id, method, arg }, transfer || []);
+    });
+};
+
+/**
+ * @param {!Object} settings
+ * @param {!Object} options
+ */
+V86.prototype.worker_start = function(settings, options)
+{
+    for(const name of ["hda", "hdb", "cdrom", "fda", "fdb", "multiboot", "fs9p"])
+    {
+        if(settings[name]) throw new Error("v86 worker: " + name + " is not supported");
+    }
+    const send = {};
+    for(const name of Object.keys(settings))
+    {
+        // live objects of this thread: the screen and serial adapters, DOM elements
+        if(name !== "screen" && name !== "screen_options" && name !== "serial_console" && name !== "fs9p_json")
+        {
+            send[name] = settings[name];
+        }
+    }
+    const transfer = new Set([options.worker.wasm]);
+    for(const name of ["bios", "vga_bios", "bzimage", "initrd", "initial_state"])
+    {
+        if(send[name] instanceof ArrayBuffer) transfer.add(send[name]);
+    }
+    settings.initial_state = undefined;
+    this.worker.postMessage({
+        t: "init",
+        settings: send,
+        wasm: options.worker.wasm,
+        zst: this.worker_zst,
+        screen: !!options.screen_container,
+        autostart: !!options.autostart,
+    }, [...transfer]);
+};
+
+/**
+ * Screen of the VGA in the worker: the calls go to the ScreenAdapter of the page, a frame as
+ * copies of its changed rectangles (transferred, not copied again)
+ *
+ * @constructor
+ * @param {function(string, *, Array=)} send
+ */
+function WorkerScreenAdapter(send)
+{
+    this.FLAG_BLINKING = 0x01;
+    this.FLAG_FONT_PAGE_B = 0x02;
+
+    /**
+     * @param {string} name
+     * @param {!Array} args
+     */
+    const call = (name, args) => send(WORKER_SCREEN, [name, args]);
+
+    this.put_char = function(row, col, chr, flags, bg_color, fg_color)
+    {
+        call("put_char", [row, col, chr, flags, bg_color, fg_color]);
+    };
+    this.update_cursor = function(row, col) { call("update_cursor", [row, col]); };
+    this.update_cursor_scanline = function(start, end, enabled) { call("update_cursor_scanline", [start, end, enabled]); };
+    this.set_mode = function(graphical) { call("set_mode", [graphical]); };
+    this.clear_text_state = function() { call("clear_text_state", []); };
+    this.set_size_text = function(cols, rows) { call("set_size_text", [cols, rows]); };
+    this.set_size_graphical = function(width, height, buffer_width, buffer_height)
+    {
+        call("set_size_graphical", [width, height, buffer_width, buffer_height]);
+    };
+    this.clear_screen = function() { call("clear_screen", []); };
+    this.set_font_bitmap = function(height, width_9px, width_dbl, copy_8th_col, vga_bitmap, vga_bitmap_changed)
+    {
+        // a view on the video memory: copy
+        call("set_font_bitmap", [height, width_9px, width_dbl, copy_8th_col, vga_bitmap.slice(), vga_bitmap_changed]);
+    };
+    this.set_font_page = function(page_a, page_b) { call("set_font_page", [page_a, page_b]); };
+    this.set_scale = function(s_x, s_y) {};
+    this.destroy = function() {};
+    this.pause = function() {};
+    this.continue = function() {};
+
+    // buffers of frames back from the page; each the size of the whole frame, so it fits any
+    // changed rectangle of this mode (svga sends one per frame: one buffer goes round)
+    /** @type {!Array<!ArrayBuffer>} */
+    this.pool = [];
+
+    /**
+     * @param {number} frame
+     * @param {number} bytes
+     * @return {!Uint8ClampedArray}
+     */
+    const take = (frame, bytes) => {
+        for(let buffer; (buffer = this.pool.pop()); )
+        {
+            // from an earlier mode: let it go
+            if(buffer.byteLength === frame) return new Uint8ClampedArray(buffer, 0, bytes);
+        }
+        return new Uint8ClampedArray(new ArrayBuffer(frame), 0, bytes);
+    };
+
+    this.update_buffer = function(layers)
+    {
+        for(const layer of layers)
+        {
+            const data = layer.image_data.data;
+            const stride = layer.image_data.width * 4;
+            const w = layer.buffer_width;
+            const h = layer.buffer_height;
+            if(w <= 0 || h <= 0) continue;
+            const pixels = take(data.length, w * h * 4);
+            if(layer.buffer_x === 0 && w === layer.image_data.width)
+            {
+                // whole rows: one copy
+                pixels.set(data.subarray(layer.buffer_y * stride, (layer.buffer_y + h) * stride));
+            }
+            else
+            {
+                for(let y = 0; y < h; y++)
+                {
+                    const from = (layer.buffer_y + y) * stride + layer.buffer_x * 4;
+                    pixels.set(data.subarray(from, from + w * 4), y * w * 4);
+                }
+            }
+            send(WORKER_FRAME, [layer.screen_x, layer.screen_y, w, h, pixels], [pixels.buffer]);
+        }
+    };
+}
+
+/**
+ * Entry of the worker: wasm, CPU and devices, the bus to the page
+ */
+V86["worker_main"] = function()
+{
+    /**
+     * @param {*} msg
