--- a/dwm.c
+++ b/dwm.c
@@ -952,27 +952,43 @@
 void
 grabkeys(void)
 {
+	/* KotelOS: regrab only the keycodes whose keysym (or the numlock mask) changed. Ungrabbing
+	 * everything and grabbing again left a gap: the first key from a keyboard makes the server
+	 * switch the core keymap and send MappingNotify, and in a slow VM the rest of that very
+	 * key combo arrived while the keys were not grabbed and went to the focused window */
+	static KeySym grabbed[256];
+	static unsigned int grabbednumlock;
+
 	updatenumlockmask();
 	{
 		unsigned int i, j, k;
 		unsigned int modifiers[] = { 0, LockMask, numlockmask, numlockmask|LockMask };
 		int start, end, skip;
-		KeySym *syms;
+		KeySym *syms, sym;
 
-		XUngrabKey(dpy, AnyKey, AnyModifier, root);
 		XDisplayKeycodes(dpy, &start, &end);
 		syms = XGetKeyboardMapping(dpy, start, end - start + 1, &skip);
 		if (!syms)
 			return;
-		for (k = start; k <= end; k++)
+		for (k = start; k <= end; k++) {
+			sym = NoSymbol;
 			for (i = 0; i < LENGTH(keys); i++)
 				/* skip modifier codes, we do that ourselves */
 				if (keys[i].keysym == syms[(k - start) * skip])
+					sym = keys[i].keysym;
+			if (sym == grabbed[k] && numlockmask == grabbednumlock)
+				continue;
+			XUngrabKey(dpy, k, AnyModifier, root);
+			grabbed[k] = sym;
+			for (i = 0; sym != NoSymbol && i < LENGTH(keys); i++)
+				if (keys[i].keysym == sym)
 					for (j = 0; j < LENGTH(modifiers); j++)
 						XGrabKey(dpy, k,
 							 keys[i].mod | modifiers[j],
 							 root, True,
 							 GrabModeAsync, GrabModeAsync);
+		}
+		grabbednumlock = numlockmask;
 		XFree(syms);
 	}
 }
