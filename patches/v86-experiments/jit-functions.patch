+/// Split the basic blocks of a module into functions of the guest: blocks connected by jumps
+/// stay together, calls into another group are cut (the target becomes an entry point of its
+/// group, the calling block leaves its function with the target as the next state). Returns the
+/// groups (ordered by address) and the cut calls (address of the block -> target)
+fn jit_split_functions(mut blocks: Vec<BasicBlock>) -> (Vec<Vec<BasicBlock>>, HashMap<u32, u32>) {
+    let mut cuts = HashMap::default();
+    if !unsafe { JIT_SPLIT_FUNCTIONS } || blocks.len() < 2 {
+        return (vec![blocks], cuts);
+    }
+
+    let index: HashMap<u32, usize> = blocks.iter().enumerate().map(|(i, b)| (b.addr, i)).collect();
+    let mut parent: Vec<usize> = (0..blocks.len()).collect();
+    fn find(parent: &mut Vec<usize>, mut x: usize) -> usize {
+        while parent[x] != x {
+            parent[x] = parent[parent[x]];
+            x = parent[x];
+        }
+        x
+    }
+    let union = |parent: &mut Vec<usize>, a: usize, b: Option<&usize>| {
+        if let Some(&b) = b {
+            let (a, b) = (find(parent, a), find(parent, b));
+            // the lower address is the root: the order of the groups is stable
+            if a < b {
+                parent[b] = a
+            }
+            else {
+                parent[a] = b
+            }
+        }
+    };
+
+    for (i, b) in blocks.iter().enumerate() {
+        if b.returns_to_next {
+            // the code after a call belongs to the calling function
+            union(&mut parent, i, index.get(&b.end_addr));
+        }
+        match b.ty {
+            BasicBlockType::ConditionalJump {
+                next_block_addr,
+                next_block_branch_taken_addr,
+                ..
+            } => {
+                if let Some(a) = next_block_addr {
+                    union(&mut parent, i, index.get(&a));
+                }
+                if let Some(a) = next_block_branch_taken_addr {
+                    union(&mut parent, i, index.get(&a));
+                }
+            },
+            BasicBlockType::Normal {
+                next_block_addr: Some(a),
+                ..
+            } => {
+                if !b.returns_to_next {
+                    union(&mut parent, i, index.get(&a));
+                }
+            },
+            BasicBlockType::Normal {
+                next_block_addr: None,
+                ..
+            }
+            | BasicBlockType::AbsoluteEip
+            | BasicBlockType::Exit => {},
+        }
+    }
+
+    for i in 0..blocks.len() {
+        let target = match blocks[i].ty {
+            BasicBlockType::Normal {
+                next_block_addr: Some(a),
+                ..
+            } if blocks[i].returns_to_next => a,
+            _ => continue,
+        };
+        let t = match index.get(&target) {
+            Some(&t) => t,
+            None => continue,
+        };
+        if find(&mut parent, i) == find(&mut parent, t) {
+            continue;
+        }
+        if let BasicBlockType::Normal {
+            next_block_addr, ..
+        } = &mut blocks[i].ty
+        {
+            *next_block_addr = None;
+        }
+        blocks[t].is_entry_block = true;
+        cuts.insert(blocks[i].addr, target);
+    }
+
+    let mut group_of_root: HashMap<usize, usize> = HashMap::default();
+    let mut groups: Vec<Vec<BasicBlock>> = Vec::new();
+    for (i, b) in blocks.into_iter().enumerate() {
+        let root = find(&mut parent, i);
+        let next = groups.len();
+        let g = *group_of_root.entry(root).or_insert(next);
+        if g == next {
+            groups.push(Vec::new());
+        }
+        groups[g].push(b);
+    }
+    (groups, cuts)
+}
+
+fn structure_entry_blocks(structure: &Vec<WasmStructure>) -> Vec<u32> {
+    let mut nodes = structure;
+    loop {
+        match &nodes[0] {
+            WasmStructure::Dispatcher(e) => return e.clone(),
+            WasmStructure::Loop { .. } => {
+                dbg_assert!(false);
+            },
+            WasmStructure::BasicBlock(_) => {
+                dbg_assert!(false);
+            },
+            // Note: We could use these blocks as entry points, which will yield
+            // more entries for free, but it requires adding those to the dispatcher
+            // It's to be investigated if this yields a performance improvement
+            // See also the comment at the bottom of this function when creating entry
+            // points
+            WasmStructure::Block(children) => {
+                nodes = children;
+                continue;
+            },
+        }
+        return Vec::new();
+    }
+}
+
+// Where a function of a split module is in the module
+struct ModulePart<'a> {
+    // false: the module is a single function
+    split: bool,
+    // states of the module that belong to this function: base .. base + count
+    base: u16,
+    count: u16,
+    // state of every entry point of the module
+    state_for_addr: &'a HashMap<u32, u16>,
+    // cut calls: address of the block -> target
+    cuts: &'a HashMap<u32, u32>,
+}
+
 fn jit_generate_module(
+    structures: Vec<Vec<WasmStructure>>,
+    basic_blocks: &Vec<HashMap<u32, BasicBlock>>,
+    cuts: &HashMap<u32, u32>,
+    cpu: CpuContext,
+    builder: &mut WasmBuilder,
+    wasm_table_index: WasmTableIndex,
+    state_flags: CachedStateFlags,
+) -> Vec<(u32, u16)> {
+    builder.reset();
+
+    let split = structures.len() > 1;
+    let mut state_for_addr: HashMap<u32, u16> = HashMap::default();
+    let mut bases = Vec::with_capacity(structures.len());
+    let mut part_of_state: Vec<u16> = Vec::new();
+    for (k, structure) in structures.iter().enumerate() {
+        bases.push(part_of_state.len() as u16);
+        for addr in structure_entry_blocks(structure) {
+            dbg_assert!(part_of_state.len() < 0xFFFF);
+            state_for_addr.insert(addr, part_of_state.len() as u16);
+            part_of_state.push(k as u16);
+        }
+    }
+
+    let mut entries = Vec::with_capacity(part_of_state.len());
+    for (k, structure) in structures.into_iter().enumerate() {
+        let count = part_of_state.len() as u16
+            - bases[k]
+            - bases.get(k + 1).map_or(0, |next| part_of_state.len() as u16 - next);
+        let part = ModulePart {
+            split,
+            base: bases[k],
+            count,
+            state_for_addr: &state_for_addr,
+            cuts,
+        };
+        entries.extend(jit_generate_function(
+            structure,
+            &basic_blocks[k],
+            cpu.clone(),
+            builder,
+            wasm_table_index,
+            state_flags,
+            &part,
+        ));
+        if split {
+            builder.finish_function();
+        }
+    }
+
+    if split {
+        // The exported function: calls the function the state belongs to until one of them
+        // leaves the module. They store the registers on return, so does this function not need
+        // them; eip is valid whenever they return
+        let state = builder.arg_local_initial_state.unsafe_clone();
+        let next_state = &raw mut JIT_NEXT_STATE as u32;
+
+        builder.load_fixed_i32(global_pointers::instruction_counter as u32);
+        let initial_instruction_counter = builder.set_new_local();
+
+        let exit_label = builder.block_void();
+        let loop_label = builder.loop_void();
+
+        builder.const_i32(next_state as i32);
+        builder.const_i32(-1);
+        builder.store_aligned_i32(0);
+
+        let done_label = builder.block_void();
+        let default_label = builder.block_void();
+        let labels: Vec<Label> = bases.iter().map(|_| builder.block_void()).collect();
+        let cases: Vec<Label> = part_of_state.iter().map(|&k| labels[k as usize]).collect();
+        builder.get_local(&state);
+        builder.brtable(default_label, &mut cases.iter());
+        for k in (0..bases.len()).rev() {
+            builder.block_end();
+            builder.get_local(&state);
+            if bases[k] != 0 {
+                builder.const_i32(bases[k] as i32);
+                builder.sub_i32();
+            }
+            builder.call_local_fn(k as u16);
+            builder.br(done_label);
+        }
+        builder.block_end(); // default case for the brtable
+        builder.unreachable();
+        builder.block_end(); // done
+
+        builder.load_fixed_i32(next_state);
+        builder.tee_local(&state);
+        builder.const_i32(0);
+        builder.lt_i32();
+        builder.br_if(exit_label);
+
+        if unsafe { JIT_USE_LOOP_SAFETY } {
+            // same limit as for loops in a function
+            builder.load_fixed_i32(global_pointers::instruction_counter as u32);
+            builder.get_local(&initial_instruction_counter);
+            builder.sub_i32();
+            builder.const_i32(cpu::LOOP_COUNTER);
+            builder.ltu_i32();
+            builder.br_if(loop_label);
+        }
+        else {
+            builder.br(loop_label);
+        }
+
+        builder.block_end(); // loop
+        builder.block_end(); // exit
+        builder.free_local(initial_instruction_counter);
+    }
+
+    builder.finish();
+
+    for blocks in basic_blocks {
+        for b in blocks.values() {
+            if b.is_entry_block {
+                dbg_assert!(entries.iter().find(|(addr, _)| *addr == b.addr).is_some());
+            }
+        }
+    }
+
+    return entries;
+}
