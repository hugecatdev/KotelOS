+// Leave the function to a target that is fixed at this place (jump, call, conditional jump out of
+// the module; eip is set): if the target is compiled, go on there with a tail call instead of
+// returning to the main loop, which would enter it with one indirect call for all the modules -
+// not predictable for the cpu, unlike the jump here that has one target. The conditions are
+// those of cpu::cycle_internal and do_many_cycles_native
+fn gen_chain_exit(ctx: &mut JitContext) {
+    if !unsafe { JIT_CHAIN } {
+        ctx.builder.br(ctx.exit_label);
+        return;
+    }
+
+    codegen::gen_move_registers_from_locals_to_memory(ctx);
+    codegen::gen_update_instruction_counter(ctx);
+
+    let builder = &mut *ctx.builder;
+    let out = builder.block_void();
+
+    builder.load_fixed_i32(global_pointers::instruction_counter as u32);
+    builder.load_fixed_i32(&raw const cpu::jit_cycle_start as u32);
+    builder.sub_i32();
+    builder.const_i32(cpu::LOOP_COUNTER);
+    builder.geu_i32();
+    builder.br_if_hint(out, false);
+
+    builder.load_fixed_i32(global_pointers::instruction_pointer as u32);
+    let eip = builder.tee_new_local();
+    builder.const_i32(12);
+    builder.shr_u_i32();
+    builder.const_i32(2);
+    builder.shl_i32();
+    builder.load_aligned_i32(&raw const cpu::tlb_code as u32);
+    let code = builder.tee_new_local();
+    builder.eqz_i32();
+    builder.br_if_hint(out, false);
+
+    builder.get_local(&code);
+    builder.load_u8(cpu::CODE_OFFSET_STATE_FLAGS);
+    builder.load_fixed_u8(global_pointers::state_flags as u32);
+    builder.ne_i32();
+    builder.br_if_hint(out, false);
+
+    builder.get_local(&code);
+    builder.get_local(&eip);
+    builder.const_i32(0xFFF);
+    builder.and_i32();
+    builder.const_i32(1);
+    builder.shl_i32();
+    builder.add_i32();
+    builder.load_aligned_u16(0);
+    let state = builder.tee_new_local();
+    builder.const_i32(u16::MAX as i32);
+    builder.eq_i32();
+    builder.br_if_hint(out, false);
+
+    builder.get_local(&state);
+    builder.get_local(&code);
+    builder.load_aligned_u16(cpu::CODE_OFFSET_WASM_TABLE_INDEX);
+    builder.const_i32(cpu::WASM_TABLE_OFFSET as i32);
+    builder.add_i32();
+    builder.return_call_indirect();
+
+    builder.block_end();
+    builder.free_local(eip);
+    builder.free_local(code);
+    builder.free_local(state);
+    builder.return_();
+}
