+            break;
+         default:
+            emit_buf(&ctx->glsl_strbufs,  "1.0");
+            break;
+         }
+         break;
+      default:
+         emit_buff(&ctx->glsl_strbufs,  "val%s", get_swizzle_string(swz));
+      }
+   }
+
+   emit_buff(&ctx->glsl_strbufs,  ");\n");
