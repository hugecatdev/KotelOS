+/* GLES without reading the destination in the shader (no framebuffer fetch, e.g. WebGL2):
+ * logic ops that blending can express - exactly when the source channels are 0 or 1 (that is how
+ * X draws rubber bands and inversions: GXxor with all ones), approximately otherwise. shader_op
+ * is what the fragment shader does to the source first (COPY - nothing). NAND and OR_REVERSE
+ * have no such form. */
+static bool logicop_by_blend(enum pipe_logicop op, GLenum *sfactor, GLenum *dfactor,
+                             enum pipe_logicop *shader_op)
+{
+   enum pipe_logicop sh = PIPE_LOGICOP_COPY;
+   GLenum sf, df;
+   switch (op) {
+   case PIPE_LOGICOP_EQUIV:        /* ~(s ^ d) = ~s ^ d */
+      sh = PIPE_LOGICOP_COPY_INVERTED;
+      /* fallthrough */
+   case PIPE_LOGICOP_XOR:          /* s(1-d) + d(1-s) */
+      sf = GL_ONE_MINUS_DST_COLOR; df = GL_ONE_MINUS_SRC_COLOR;
+      break;
+   case PIPE_LOGICOP_OR_INVERTED:  /* ~s | d */
+      sh = PIPE_LOGICOP_COPY_INVERTED;
+      /* fallthrough */
+   case PIPE_LOGICOP_OR:           /* s(1-d) + d */
+      sf = GL_ONE_MINUS_DST_COLOR; df = GL_ONE;
+      break;
+   case PIPE_LOGICOP_AND:          /* s d */
+      sf = GL_DST_COLOR; df = GL_ZERO;
+      break;
+   case PIPE_LOGICOP_AND_INVERTED: /* (1-s) d */
+      sf = GL_ZERO; df = GL_ONE_MINUS_SRC_COLOR;
+      break;
+   case PIPE_LOGICOP_NOR:          /* ~(s | d) = ~s & ~d */
+      sh = PIPE_LOGICOP_COPY_INVERTED;
+      /* fallthrough */
+   case PIPE_LOGICOP_AND_REVERSE:  /* s (1-d) */
+      sf = GL_ONE_MINUS_DST_COLOR; df = GL_ZERO;
+      break;
+   case PIPE_LOGICOP_INVERT:       /* 1-d: the shader outputs 1 */
+      sh = PIPE_LOGICOP_SET;
+      sf = GL_ONE_MINUS_DST_COLOR; df = GL_ZERO;
+      break;
+   case PIPE_LOGICOP_NOOP:
+      sf = GL_ZERO; df = GL_ONE;
+      break;
+   default:
+      return false;
+   }
+   if (sfactor) *sfactor = sf;
+   if (dfactor) *dfactor = df;
+   if (shader_op) *shader_op = sh;
+   return true;
+}
