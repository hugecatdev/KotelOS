+/* Show a frame: read the box back from the host into the guest copy (the
+ * implicit stride is width * cpp), copy it into the display target, show it. */
+static void
+virgl_drm_sw_flush_frontbuffer(struct virgl_winsys *vws,
+                               UNUSED struct virgl_cmd_buf *cmdbuf,
+                               struct virgl_hw_res *res,
+                               unsigned level, unsigned layer,
+                               void *winsys_drawable_handle,
+                               struct pipe_box *sub_box)
+{
+   struct sw_winsys *sws = virgl_drm_winsys(vws)->sws;
+   uint32_t cpp = util_format_get_blocksize(res->format);
+   uint32_t stride = res->width * cpp;
+   struct pipe_box box;
+   uint8_t *src, *dst;
+
+   if (!res->dt)
+      return;
+   if (sub_box) {
+      box = *sub_box;
+      box.z = layer;
+      box.depth = 1;
+   } else {
+      u_box_3d(0, 0, layer, res->width, res->height, 1, &box);
+   }
+   if (box.x < 0 || box.y < 0 || box.width <= 0 || box.height <= 0 ||
+       box.x + box.width > (int)res->width || box.y + box.height > (int)res->height)
+      return;
+
+   uint32_t offset = box.y * stride + box.x * cpp;
+   virgl_bo_transfer_get(vws, res, &box, stride, 0, offset, level);
+   virgl_drm_resource_wait(vws, res);
+   src = virgl_drm_resource_map(vws, res);
+   dst = sws->displaytarget_map(sws, res->dt, PIPE_MAP_WRITE);
+   if (src && dst) {
+      for (int y = 0; y < box.height; y++)
+         memcpy(dst + (box.y + y) * res->dt_stride + box.x * cpp,
+                src + offset + y * stride, box.width * cpp);
+   }
+   if (dst)
+      sws->displaytarget_unmap(sws, res->dt);
+   sws->displaytarget_display(sws, res->dt, winsys_drawable_handle,
+                              !!sub_box, sub_box);
+}
+
+static void
+virgl_drm_sw_winsys_destroy(struct virgl_winsys *qws)
+{
+   int fd = virgl_drm_winsys(qws)->fd;
+
+   virgl_drm_winsys_destroy(qws);
+   close(fd);
+}
+
+struct virgl_winsys *
+virgl_drm_winsys_wrap_sw(struct sw_winsys *sws)
+{
+   for (int i = 0; i < 8; i++) {
+      char path[32];
+      snprintf(path, sizeof(path), "/dev/dri/renderD%d", 128 + i);
+      int fd = open(path, O_RDWR | O_CLOEXEC);
+      if (fd < 0)
+         continue;
+
+      drmVersionPtr v = drmGetVersion(fd);
+      bool virtio = v && v->name && !strcmp(v->name, "virtio_gpu");
+      drmFreeVersion(v);
+
+      struct virgl_winsys *vws = virtio ? virgl_drm_winsys_create(fd) : NULL;
+      if (vws) {
+         virgl_drm_winsys(vws)->sws = sws;
+         vws->destroy = virgl_drm_sw_winsys_destroy;
+         vws->flush_frontbuffer = virgl_drm_sw_flush_frontbuffer;
+         return vws;
+      }
+      close(fd);
+   }
+   return NULL;
+}
