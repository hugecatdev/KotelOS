# ==== Архитектура: i686, v86 не умеет 64-бит ====
BR2_x86_i686=y
# ==== Тулчейн: musl — меньше размер образа ====
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# ==== Ядро 6.6 с кастомным конфигом ====
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.32"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="linux.config"
BR2_LINUX_KERNEL_BZIMAGE=y
# ==== initramfs встроен прямо в bzImage — один выходной файл ====
BR2_TARGET_ROOTFS_INITRAMFS=y
# ==== Overlay с кастомными командами ====
BR2_ROOTFS_OVERLAY="/home/builder/overlay"
# ==== Система: BusyBox init, автологин на serial ====
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="/home/builder/busybox.fragment"
BR2_SYSTEM_BIN_SH_ASH=y
# консоль на ttyS0 — именно её читает наша HTML-страница через serial0
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# пустой пароль root + автологин
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_HOSTNAME="web"
BR2_TARGET_GENERIC_ISSUE="Welcome"
# немного полезных утилит (можно расширять)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# ==== Сеть: DHCP на eth0 при загрузке (udhcpc из busybox) ====
BR2_SYSTEM_DHCP="eth0"
# ==== Lua 5.4 ====
BR2_PACKAGE_LUA=y
# ==== nano + ncurses с терминфо для xterm ====
BR2_PACKAGE_NANO=y
BR2_PACKAGE_NCURSES=y
# если nano жалуется на терминал — добавь запись явно:
# BR2_PACKAGE_NCURSES_ADDITIONAL_TERMINFO="x/xterm-256color"
# ==== Опционально: curl с TLS для https (добавит ~2МБ) ====
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
