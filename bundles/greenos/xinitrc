#!/bin/sh
# сессия GreenOS (startx): JWM - панель, меню «Пуск», обои (/etc/system.jwmrc, своё - ~/.jwmrc).
# Переводы программ (Xfe) - русские; кодировка и всё остальное - прежние (LANG=C.UTF-8). Приветствие - herbe.
# Выход - меню, «Выйти»
export LC_MESSAGES=ru_RU.UTF-8
(sleep 8; herbe "Добро пожаловать в GreenOS" "Программы - в меню слева внизу") &
exec jwm
