#!/bin/sh
# сессия GreenOS (startx): JWM - панель, меню «Пуск», обои (/etc/system.jwmrc, своё - ~/.jwmrc).
# Переводы программ (Xfe) - русские; кодировка и всё остальное - прежние (LANG=C.UTF-8).
# Выход - меню, «Выйти». Программы с панели и из меню открываются в домашней папке (cd)
# Полоска громкости: greenos-volume пишет уровень в FIFO /tmp/.xob, xob держит его открытым на чтение
# и запись - поток не кончается, и запись без xob не повиснет
export LC_MESSAGES=ru_RU.UTF-8
cd
[ -p /tmp/.xob ] || mkfifo /tmp/.xob
xob -m 31 <> /tmp/.xob &
exec jwm
