#!/bin/sh
# меню «Пуск» GreenOS для JWM (<Include>exec:/usr/lib/greenos/menu</Include> в /etc/system.jwmrc): программы под
# своими именами. Значки - родные значки программ, где они есть, иначе MATE Menta (/usr/share/greenos/icons).
# Разделы - как в MATE: редактор, калькулятор, архиватор - «Стандартные», терминал и файловый менеджер -
# «Система». Dillo без релея (сеть по умолчанию - fetch) почти ничего не откроет - при запуске подсказка, где
# включить. «Сохранить сеанс» - kt save, ответ - herbe (ошибки - 2>/dev/stdout, без & в XML).
# Поставленное через kt pkg add - из его .desktop (/usr/share/applications): раздел по Categories, имя, значок
# темы hicolor или pixmaps; кроме программ, что уже есть ниже. После add и rm меню пересобирает триггер kt pkg
# (/var/lib/kt/trigger/greenos-menu: jwm -reload). «На рабочий стол» - те же программы по тем же
# разделам: выбранная встаёт значком на стол (/usr/lib/greenos/desk add N - строка N из /tmp/.greenos-apps:
# имя, значок, команда - их меню пишет каждый раз заново)
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT

item() {  # item раздел программа значок [команда]: значок - путь или имя из /usr/share/greenos/icons
  case $3 in /*) i=$3 ;; *) i=/usr/share/greenos/icons/$3.png ;; esac
  echo "$2" >> "$d/known"
  echo "<Program icon=\"$i\" label=\"$2\">${4:-$2}</Program>" >> "$d/$1"
  desk "$1" "$2" "$i" "$(printf '%s' "${4:-$2}" | sed 's/&lt;/</g; s/&gt;/>/g; s/&amp;/\&/g')"
}
desk() {  # desk раздел имя значок команда: пункт «На рабочий стол» (имя - уже для XML, команда - как есть)
  printf '%s\t%s\t%s\n' "$2" "$3" "$4" | sed 's/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g; s/&amp;/\&/g' >> "$d/apps"
  echo "<Program icon=\"$3\" label=\"$2\">/usr/lib/greenos/desk add $(wc -l < "$d/apps")</Program>" >> "$d/desk.$1"
}
net() {  # net значок название значение
  echo "<Program icon=\"$1.png\" label=\"$2\">/usr/lib/greenos/net $3</Program>"
}

item office Ted /usr/share/Ted/Ted.png
item utilities adie /usr/share/greenos/icons/fox/adie.png
item utilities calculator /usr/share/greenos/icons/fox/calculator.png
item utilities xclock clock
item utilities xfa /usr/share/pixmaps/xfa.png
item internet dillo /usr/share/icons/hicolor/48x48/apps/dillo.png \
  "case \$(kt cfg net.relay) in fetch|off) herbe 'Dillo ходит в интернет через релей' 'Система - Сеть' &amp; ;; esac; exec dillo"
item graphics azpainter /usr/share/pixmaps/azpainter.png
item graphics xfi /usr/share/pixmaps/xfi.png
item graphics feh /usr/share/feh/images/feh.png 'feh --scale-down -g 900x600 -. /usr/share/backgrounds'
item graphics shutterbug /usr/share/greenos/icons/fox/shutterbug.png
item development micropython python 'xterm -T micropython -e micropython'
item games lbreakout2 /usr/share/lbreakout2/gfx/win_icon.png
item games xroach /usr/share/greenos/icons/extras/xroach.png 'pkill -x xroach || exec xroach'
item games oneko /usr/share/greenos/icons/extras/oneko.png 'pkill -x oneko || exec oneko'
item games xeyes eyes
item system xterm /usr/share/pixmaps/xterm-color_48x48.xpm
item system xfe /usr/share/pixmaps/xfe.png
item system xosview /usr/share/pixmaps/xosview.png
item system htop monitor 'xterm -e htop'
item system ControlPanel appearance
item system xkill kill

# .desktop: раздел<TAB>имя<TAB>значок<TAB>команда; поля %f %U и т.п. - долой, Terminal=true - в xterm
awk -F= '
  function flush() {
    if (name != "" && cmd != "" && !hide) {
      s = "other"
      if (cat ~ /(^|;)Game;/) s = "games"
      else if (cat ~ /(^|;)Office;/) s = "office"
      else if (cat ~ /(^|;)Graphics;/) s = "graphics"
      else if (cat ~ /(^|;)Development;/) s = "development"
      else if (cat ~ /(^|;)Network;/) s = "internet"
      else if (cat ~ /(^|;)(AudioVideo|Audio|Video);/) s = "multimedia"
      else if (cat ~ /(^|;)(System|Settings);/) s = "system"
      else if (cat ~ /(^|;)Utility;/) s = "utilities"
      gsub(/ %[a-zA-Z]/, "", cmd)
      if (term == "true") cmd = "xterm -e " cmd
      print s "\t" name "\t" icon "\t" cmd
    }
    name = ""; cmd = ""; icon = ""; cat = ""; term = ""; hide = 0; entry = 0
  }
  FNR == 1 { flush() }
  /^\[/ { entry = ($0 == "[Desktop Entry]"); next }
  !entry { next }
  { v = substr($0, length($1) + 2) }
  $1 == "Name" && name == "" { name = v }
  $1 == "Exec" { cmd = v }
  $1 == "Icon" { icon = v }
  $1 == "Categories" { cat = ";" v }
  $1 == "Terminal" { term = v }
  ($1 == "NoDisplay" || $1 == "Hidden") && v == "true" { hide = 1 }
  $1 == "OnlyShowIn" { hide = 1 }
  END { flush() }
' /usr/share/applications/*.desktop 2> /dev/null | sort -t "$(printf '\t')" -k2 |
while IFS="$(printf '\t')" read -r s name icon cmd; do
  p=${cmd#xterm -e }
  p=${p%% *}
  p=${p##*/}
  ! grep -qxF "$p" "$d/known" || continue
  i=/usr/share/greenos/icons/executable.png
  case $icon in
    /*) i=$icon ;;
    ?*) for f in /usr/share/icons/hicolor/48x48/apps/$icon.png /usr/share/icons/hicolor/64x64/apps/$icon.png \
          /usr/share/icons/hicolor/32x32/apps/$icon.png /usr/share/icons/hicolor/128x128/apps/$icon.png \
          /usr/share/pixmaps/$icon.png /usr/share/pixmaps/$icon.xpm; do
          [ ! -f "$f" ] || { i=$f; break; }
        done ;;
  esac
  raw=$cmd
  name=$(printf '%s' "$name" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')
  cmd=$(printf '%s' "$cmd" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
  echo "<Program icon=\"$i\" label=\"$name\">$cmd</Program>" >> "$d/$s"
  desk "$s" "$name" "$i" "$raw"
done
mv "$d/apps" /tmp/.greenos-apps

menu() {  # menu раздел значок название [префикс файла]: раздел, если в нём есть программы
  [ ! -f "$d/$4$1" ] || printf '<Menu icon="%s.png" label="%s">\n%s\n</Menu>\n' "$2" "$3" "$(cat "$d/$4$1")"
}
cat <<EOF
<?xml version="1.0"?>
<JWM>
<RootMenu onroot="3" height="28">
$(menu office office Офис)
$(menu utilities utilities Стандартные)
$(menu internet internet Интернет)
$(menu graphics graphics Графика)
$(menu multimedia multimedia "Звук и видео")
$(menu development development Разработка)
$(menu games games Развлечения)
$(menu system system Система | sed '$d')
<Menu icon="network.png" label="Сеть">
$(net network-offline 'Без сети' off; net network-browser 'Только через браузер' fetch
  net network-relay 'Интернет: relay.widgetry.org' wss://relay.widgetry.org/)
</Menu>
</Menu>
$(menu other other Прочее)
<Menu icon="desktop.png" label="На рабочий стол">
$(menu office office Офис desk.)
$(menu utilities utilities Стандартные desk.)
$(menu internet internet Интернет desk.)
$(menu graphics graphics Графика desk.)
$(menu multimedia multimedia "Звук и видео" desk.)
$(menu development development Разработка desk.)
$(menu games games Развлечения desk.)
$(menu system system Система desk.)
$(menu other other Прочее desk.)
</Menu>
<Separator/>
<Program icon="save.png" label="Сохранить сеанс">herbe "\$(kt save 2>/dev/stdout)"</Program>
<Program icon="about.png" label="О системе">greenos-about</Program>
<Restart icon="restart.png" label="Перезапустить JWM"/>
<Exit icon="exit.png" label="Выйти" confirm="true"/>
</RootMenu>
</JWM>
EOF
