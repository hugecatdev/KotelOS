#!/bin/sh
# сеть из меню «Система» - «Сеть» (/usr/lib/greenos/menu): kt net и ответ уведомлением herbe
case $1 in
  off) what="Без сети" ;;
  fetch) what="Только через браузер" ;;
  *) what="Интернет через ${1#*://}" ;;
esac
what=${what%/}
if out=$(kt net "$1" 2>&1); then
  addr=$(printf '%s\n' "$out" | sed -n 's/^  \([0-9.]*\)  в сети релея$/адрес \1/p')
  herbe "$what" ${addr:+"$addr"}
else
  herbe "Сеть не переключилась" "$out"
fi
