# ============================================================
#  Linux 6.6 kernel config для v86 (i686)
#  Минимальный набор: serial-консоль, PS/2 ввод, initramfs, сеть.
#  Buildroot дополнит недостающие опции через olddefconfig.
# ============================================================
# --- Базовая архитектура ---
CONFIG_64BIT=n
CONFIG_X86_32=y
CONFIG_M686=y
CONFIG_HIGHMEM=n
CONFIG_SMP=n
# --- Общее ядро ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# --- ФС ---
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# --- TTY / serial (главное для v86 serial-консоли) ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# --- Ввод: PS/2 клавиатура (эмулируется v86) ---
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
# --- VGA (на случай, если захочешь графический экран) ---
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# --- Диск (если будешь грузить hda вместо initramfs) ---
CONFIG_BLOCK=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
# --- PCI ---
CONFIG_PCI=y
# --- Сеть: стек + сокеты ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IP_MULTICAST=n
# --- Сетевая карта: v86 эмулирует ne2k (RTL8029, PCI) ---
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_8390=y
CONFIG_NE2K_PCI=y
# --- Отключаем тяжёлое/ненужное для компактности ---
CONFIG_MODULES=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WIRELESS=n
